                    <BSButton Color="BSColor.Danger" Size="Size.ExtraSmall" OnClick=Back>  Back <span class="oi oi-arrow-left"></span></BSButton>
                </BSCol>
            </BSForm>
            }

        </NotAuthorized>

    </AuthorizeView>
    @if (loader)
    {
        <div class="loader"></div>
    }
    <p></p>
    <p></p>

    @if (CambiosFecha.Count() > 0)
    {
        <p> Remaining Work Date Changes: @(4 - CambiosFecha.Count()) </p>
        <div style="width: 40vw;">
            <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
                <BSTHead Class="cabecera">
                    <BSTR>
                        <BSTD>#</BSTD>
                        <BSTD>Change Date</BSTD>
                        <BSTD>New Work Date</BSTD>
                        <BSTD>User</BSTD>
                    </BSTR>
                </BSTHead>
                <BSTBody>
                    @foreach (var d in CambiosFecha)
                    {
                        <BSTR>
                            <BSTD>@(CambiosFecha.IndexOf(d) + 1)</BSTD>
                            <BSTD>@d.Cffec.ToString("yyyy/MM/dd")</BSTD>
                                <BSTD>@d.CffecNew.ToString("yyyy/MM/dd")</BSTD>
                                <BSTD>@d.Cfuser</BSTD>
                            </BSTR>
                    }
                </BSTBody>
            </BSTable>
        </div>
    }
