@if (CambiosFecha.Count() > 0)
{
    <p> @DiccionarioTraduccionesService.Traducciones["CambiosDeFechaDeTrabajoRestantes"] @(3 - CambiosFecha.Count()) </p>
    <div style="width: 40vw;">
        <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
            <BSTHead Class="cabecera">
                <BSTR>
                    <BSTD>#</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDelCambio"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["NuevaFechaDeTrabajo"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Usuario"]</BSTD>
                </BSTR>
            </BSTHead>
            <BSTBody>
                @foreach (var d in CambiosFecha)
                {
                    <BSTR>
                        <BSTD>@(CambiosFecha.IndexOf(d) + +1)</BSTD>
                        <BSTD>@d.Cffec.ToString("yyyy/MM/dd")</BSTD>
                            <BSTD>@d.CffecNew.ToString("yyyy/MM/dd")</BSTD>
                            <BSTD>@d.Cfuser</BSTD>
                        </BSTR>
                }
            </BSTBody>
        </BSTable>
    </div>
}
<style>
    .box__relative{
        position: relative;
    }

    .box__absolute{
        position: absolute;
        height: 300px;
        width: 590px;
        right: 0;
        top: 100px;
        padding: 20px;
    }

</style>
</div>
}
@code {

    [Parameter]
    public int? Id { get; set; }
    [Parameter]
    public int? tipo { get; set; }
    [Parameter]
    public string? f1 { get; set; }
    [Parameter]
    public string? linea { get; set; }
    [Parameter]
    public string? f2 { get; set; }
    [Parameter]
    public string? est { get; set; }
    [Parameter]
    public string? codigo { get; set; }
    [Parameter]
    public int? responsable { get; set; }
    [Parameter]
    public int? KsfF { get; set; }
    public int reunionQuincenal = 3;
    List<DateTime>fechaf = new List<DateTime>();
    string _message = "";
    bool cambio = true;
    bool loader = true;

    ReunionDTO DiscForm = new ReunionDTO();//Formulario para editar, la discrepancia
    CambStatDTO CambStat = new CambStatDTO();//Formulario para agregar que usuario hizo el cambio de status.
    CambFecDTO CambFec = new CambFecDTO();//Formulario para agregar que usuario hizo el cambio de fecha.

    List<CambFecDTO> CambiosFecha = new List<CambFecDTO>();//Lista para  cambio de fecha.

    private NotifiRadzen Notificar = new NotifiRadzen();//Logic para crear las noyificaciones radzen

    private DateTime fechahoy, fechatrabajo = DateTime.Today;
    private string fechahoy2, Emp = "";//Empresa
    private string planificador;//Variable para verificar si es el usuario del planificador;
    private string camStat;//Variable para verificar si es el usuario cambio el Status;
    private string PlanOld;//Variable para verificar si es el usuario cambio el plan de accion;
    private DateTime? camFec;//Variable para verificar si es el usuario cambio la Fecha;
    private bool EsSuperUser; //Variable para verificar que el usuario sea SuperIntendente
    private bool EsAdmin; // Variable para verificar que el usuario sea Administrador
    private bool EsPlanificador;
    private bool EsPrimeUser;
    private List<Claim> claims { get; set; }//obtener datos del token
    int dataIsLoaded = 0;
    private bool traduccionesCargadas = false;
    private int idPais { get; set; }
    private static string E(string? s) => Uri.EscapeDataString(s ?? string.Empty);
    private List<FechaProgDTO> fechasProgramadas = new();
    private string NombreEquipoSeleccionado = string.Empty;

    private void OnCodigoEquipoChanged(ChangeEventArgs e)
    {
        DiscForm.RdcodEq = e.Value?.ToString();
        ActualizarNombreEquipo();
    }

    private void ActualizarNombreEquipo()
    {
        if (MaestraData?.equipos == null || !MaestraData.equipos.Any())
        {
            NombreEquipoSeleccionado = string.Empty;
            return;
        }

        var codigoNormalizado = (DiscForm.RdcodEq ?? string.Empty).Trim();

        NombreEquipoSeleccionado = MaestraData.equipos
            .FirstOrDefault(x =>
                x.EcodEquiEam != null &&
                x.EcodEquiEam.Trim().Equals(codigoNormalizado, StringComparison.OrdinalIgnoreCase)
            )
            ?.EnombreEam
            ?? DiccionarioTraduccionesService.Traducciones["EquipoNoDisponible"];
    }
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        EsSuperUser = user.IsInRole("SuperUser");
        EsAdmin = user.IsInRole("Admin");
        EsPlanificador = user.IsInRole("Planificador");
        EsPrimeUser = user.IsInRole("PrimeUser");

        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
                traduccionesCargadas = true;
    }

    private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await CreateData();
        loader = true;

        // 1️⃣ Cargar discrepancia
        DiscForm = await PizarraData.GetDiscrepantacia((int)Id);   
        // Si el backend no lo trae, intentamos recuperar el valor visual desde Pendientes
        if (string.IsNullOrWhiteSpace(DiscForm.EnombreEam))
        {
            var cache = await LocalStorage.GetItemAsStringAsync($"EqName_{Id}");
            if (!string.IsNullOrWhiteSpace(cache))
                DiscForm.EnombreEam = cache;
        }
        // (Opcional) limpiar para no dejar basura
        await LocalStorage.RemoveItemAsync($"EqName_{Id}");

        NombreEquipoSeleccionado = string.IsNullOrWhiteSpace(DiscForm.EnombreEam)
            ? DiccionarioTraduccionesService.Traducciones["EquipoNoDisponible"]
            : DiscForm.EnombreEam.Trim();
        // 2️⃣ Cargar maestra desde IdMaster
        if (DiscForm.IdMaster.HasValue)
        {
            MaestraData.maestra =
                await MaestraData.GetMaestraXLinea(DiscForm.IdMaster.Value);

            var idLinea = MaestraData.maestra
                .FirstOrDefault()
                ?.IdLinea;

            if (idLinea.HasValue)
            {
                MaestraData.equipos =
                    await MaestraData.GetEquiposEAMPorLinea(idLinea.Value);

                ActualizarNombreEquipo();
            }
        }


        Emp = claims[5].Value;
        planificador = claims[1].Value;
        await AvisadorData.GetCambioFecha((int)Id);
        CambiosFecha = AvisadorData.cambiofecha;

        camStat = DiscForm.Rdstatus;
        camFec = DiscForm.RdfecTra;
        PlanOld = DiscForm.RdplanAcc;

        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        var todas = await MaestraData.GetFechaTrabajoXIdMaster(
            (int)DiscForm.IdMaster,
            incluirInactivos: true
        );

        fechasProgramadas = todas
            .Where(f => f.Fpestado)               // ✅ solo activas
            .Where(f => f.Fpprogra >= DateTime.Now)
            .OrderBy(f => f.Fpprogra)
            .ToList();
        RespoReuData.resporeus = RespoReuData.resporeus.Where(a => a.Rrdesc == claims.FirstOrDefault(c => c.Type.Contains("Empresa"))?.Value || string.IsNullOrEmpty(a.Rrdesc)).ToList();
        loader = false;
        DiscForm.RdcodRequi ??="0";
    }

    async Task AgregarFecha(FechaProgDTO e)
    {
        DiscForm.RdfecTra = e.Fpprogra;
    }

    private static string DoubleEncode(string? s)
    {
        s ??= string.Empty;
        return Uri.EscapeDataString(Uri.EscapeDataString(s));
    }
    
    private async Task Back()
{
    string backcentro = DiscForm?.Rdcentro ?? "1";
    string backdiv    = DiscForm?.Rddiv    ?? "1";

    // Mantener IdCausaCal del formulario
    int currentIdCausaCal = DiscForm?.IdCausaCal ?? 0;

    // Obtener IDs numéricos de centro/división
    CentroDivisionDTO centrodiv = await PizarraData.GetCentroDivi(backcentro, backdiv, 1);

    string lang          = idPais == 5 ? "en" : "es";
    string accionEnc     = E(centrodiv.IdCentro.ToString());
    string divisionEnc   = E(centrodiv.IdDivision.ToString());
    string lineaEnc      = E(linea ?? "Todo");
    string f1Enc         = E(f1 ?? DateTime.Today.ToString("dd-MM-yyyy"));
    string f2Enc         = E(f2 ?? DateTime.Today.ToString("dd-MM-yyyy"));
    string estEnc        = E(est ?? "Todo");
    string codigoEnc     = E(string.IsNullOrWhiteSpace(codigo) ? "Total Pendiente" : codigo);
    string responsableEnc= E((responsable ?? 0).ToString());
    string ksfEnc        = E((KsfF ?? 0).ToString());

    string ruta;
    if (tipo == 0 || tipo == 2)
    {
        ruta = $"{lang}/{(lang == "en" ? "remaining" : "pendientes")}/" +
               $"{accionEnc}/{divisionEnc}/{lineaEnc}/{f1Enc}/{f2Enc}/{tipo}/" +
               $"{estEnc}/{codigoEnc}/{responsableEnc}/{ksfEnc}";
    }
    else // tipo == 1 (reunión)
    {
        ruta = $"{lang}/{(lang == "en" ? "meeting" : "reunion")}/" +
               $"{accionEnc}/{divisionEnc}/{lineaEnc}/{f1Enc}/{f2Enc}/{tipo}/{estEnc}";
    }

    NavigationManager.NavigateTo(ruta);

    // Restaurar valor que preservabas
    DiscForm.IdCausaCal = currentIdCausaCal;
}

private async Task Editar()
{
    try
    {
        // ✅ Límite de cambios de fecha: máximo 3 por registro
        if (CambiosFecha.Count() >= 3 && camFec != DiscForm.RdfecTra)
        {
            NotificationService.Notify(Notificar.Notificacion(
                "error",
                DiccionarioTraduccionesService.Traducciones["Atencion"],
                DiccionarioTraduccionesService.Traducciones["Limite"]
            ));
            return;
        }

        // ✅ Validación de plan de acción en cierre
        if (string.IsNullOrEmpty(DiscForm.RdplanAcc) && DiscForm.Rdstatus == "Cerrado")
        {
            NotificationService.Notify(Notificar.Notificacion(
                "advertencia",
                DiccionarioTraduccionesService.Traducciones["Atencion"],
                DiccionarioTraduccionesService.Traducciones["NPA1"]
            ));
            return;
        }

        // ✅ Evitar cambio a vacío si antes había plan
        if (PlanOld != DiscForm.RdplanAcc && string.IsNullOrEmpty(DiscForm.RdplanAcc))
        {
            NotificationService.Notify(Notificar.Notificacion(
                "advertencia",
                DiccionarioTraduccionesService.Traducciones["Atencion"],
                DiccionarioTraduccionesService.Traducciones["NPA2"]
            ));
            DiscForm.RdplanAcc = PlanOld;
            return;
        }

        // Flags de cambios
        bool huboCambioStat = camStat != DiscForm.Rdstatus;
        bool huboCambioFec  = camFec  != DiscForm.RdfecTra;

        // ✅ Trazabilidad de cambio de status
        if (huboCambioStat)
        {
            CambStat.IdReuDia = DiscForm.IdReuDia;
            CambStat.Cbfecha  = DateTime.Now;
            CambStat.Cbstat   = DiscForm.Rdstatus;
            CambStat.Cbuser   = $"{claims[2].Value} {claims[3].Value}";
        }

        // ✅ Trazabilidad de cambio de fecha
        if (huboCambioFec)
        {
            CambFec.IdReuDia  = DiscForm.IdReuDia;
            CambFec.Cffec     = DateTime.Now;
            CambFec.CffecNew  = DiscForm.RdfecTra;
            CambFec.Cfuser    = $"{claims[2].Value} {claims[3].Value}";
        }

        // ✅ Guardar cambios
        var resultado = await PizarraData.UpdateDiscrepancia2(DiscForm, (int)Id);
        cambio = resultado.success;

        if (!cambio)
        {
            NotificationService.Notify(Notificar.Notificacion(
                "advertencia",
                DiccionarioTraduccionesService.Traducciones["FalloR"],
                DiccionarioTraduccionesService.Traducciones["ErrorP"]
            ));
            return;
        }

        // ✅ Persistir trazas solo si aplican
        if (huboCambioStat) await AvisadorData.InsertCambioStatus(CambStat);
        if (huboCambioFec)  await AvisadorData.InsertCambioFec(CambFec);

        // ✅ Navegación: codificar TODOS los segmentos UNA SOLA VEZ
        string lang          = idPais == 5 ? "en" : "es";
        string accionEnc     = E(resultado.centro   ?? "1");
        string divisionEnc   = E(resultado.division ?? "1");
        string lineaEnc      = E(linea ?? "Todo");
        string f1Enc         = E(f1 ?? DateTime.Today.ToString("dd-MM-yyyy"));
        string f2Enc         = E(f2 ?? DateTime.Today.ToString("dd-MM-yyyy"));
        string estEnc        = E(est ?? "Todo");
        string codigoEnc     = E(string.IsNullOrWhiteSpace(codigo) ? "Total Pendiente" : codigo);
        string responsableEnc= E((responsable ?? 0).ToString());
        string ksfEnc        = E((KsfF ?? 0).ToString());

        string ruta;
        if (tipo == 0 || tipo == 2)
        {
            ruta = $"{lang}/{(lang == "en" ? "remaining" : "pendientes")}/" +
                    $"{accionEnc}/{divisionEnc}/{lineaEnc}/{f1Enc}/{f2Enc}/{tipo}/" +
                    $"{estEnc}/{codigoEnc}/{responsableEnc}/{ksfEnc}";
        }
        else // tipo == 1 (reunión)
        {
            ruta = $"{lang}/{(lang == "en" ? "meeting" : "reunion")}/" +
                    $"{accionEnc}/{divisionEnc}/{lineaEnc}/{f1Enc}/{f2Enc}/{tipo}/{estEnc}";
        }

        NavigationManager.NavigateTo(ruta);
    }
    catch (Exception)
    {
        NotificationService.Notify(Notificar.Notificacion(
            "error",
            DiccionarioTraduccionesService.Traducciones["ErrorInesp"],
            DiccionarioTraduccionesService.Traducciones["Reload"]
        ));
    }
}





}
