@code {

    [Parameter]
    public int? Id { get; set; }
    [Parameter]
    public int? tipo { get; set; }
    [Parameter]
    public string? f1 { get; set; }
    [Parameter]
    public string? linea { get; set; }
    [Parameter]
    public string? f2 { get; set; }
    [Parameter]
    public string? est { get; set; }
    [Parameter]
    public string? codigo { get; set; }
    [Parameter]
    public int? responsable { get; set; }
    [Parameter]
    public int? KsfF { get; set; }
    public int reunionQuincenal = 3;
    List<DateTime>fechaf = new List<DateTime>();
    string _message = "";
    bool cambio = true;
    bool loader = true;

    ReunionDTO DiscForm = new ReunionDTO();//Formulario para editar, la discrepancia
    CambStatDTO CambStat = new CambStatDTO();//Formulario para agregar que usuario hizo el cambio de status.
    CambFecDTO CambFec = new CambFecDTO();//Formulario para agregar que usuario hizo el cambio de fecha.

    List<CambFecDTO> CambiosFecha = new List<CambFecDTO>();//Lista para  cambio de fecha.

    private NotifiRadzen Notificar = new NotifiRadzen();//Logic para crear las noyificaciones radzen

    private DateTime fechahoy, fechatrabajo = DateTime.Today;
    private string fechahoy2, Emp = "";//Empresa
    private string planificador;//Variable para verificar si es el usuario del planificador;
    private string camStat;//Variable para verificar si es el usuario cambio el Status;
    private string PlanOld;//Variable para verificar si es el usuario cambio el plan de accion;
    private DateTime? camFec;//Variable para verificar si es el usuario cambio la Fecha;
    private bool EsSuperUser; //Variable para verificar que el usuario sea SuperIntendente
    private bool EsAdmin; // Variable para verificar que el usuario sea Administrador

    private List<Claim> claims { get; set; }//obtener datos del token

    private int idPais { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        EsSuperUser = user.IsInRole("SuperUser");
        EsAdmin = user.IsInRole("Admin");
    }

    private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
            var culture = new System.Globalization.CultureInfo(paisTemp == 5 ? "en" : "es");
            System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
            await LocalStorage.SetItemAsync("userCulture", culture.Name);
        }
    }

    protected override async Task OnParametersSetAsync()
    {

        await CreateData();
        loader = true;
        Emp = claims[5].Value;
        planificador = claims[1].Value;
        DiscForm = await PizarraData.GetDiscrepantacia((int)Id);
        await AvisadorData.GetCambioFecha((int)Id);
        CambiosFecha = AvisadorData.cambiofecha;

        camStat = DiscForm.Rdstatus;
        camFec = DiscForm.RdfecTra;
        PlanOld = DiscForm.RdplanAcc;

        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        await MaestraData.GetFechaTrabajoXIdMaster((int)DiscForm.IdMaster);
        await getFecha();
        RespoReuData.resporeus = RespoReuData.resporeus.Where(a => a.Rrdesc == claims.FirstOrDefault(c => c.Type.Contains("Empresa"))?.Value || string.IsNullOrEmpty(a.Rrdesc)).ToList();
        loader = false;
    }

    async Task AgregarFecha(FechaProgDTO e)
    {
        DiscForm.RdfecTra = e.Fpprogra;
    }

    async Task getFecha()
    {
        MaestraData.fechaProg = MaestraData.fechaProg.Where(f => f.Fpprogra >= DateTime.Now).OrderBy(f => f.Fpprogra).ToList();
    }
    
    async Task Back()
    {
        string backcentro = DiscForm?.Rdcentro ?? "1";
        string backdiv = DiscForm?.Rddiv ?? "1";
        int currentIdCausaCal = DiscForm?.IdCausaCal ?? 0;

        CentroDivisionDTO centrodiv = await PizarraData.GetCentroDivi(backcentro, backdiv, 1);

        string lang = idPais == 5 ? "en" : "es";
        string accion = centrodiv.IdCentro.ToString();
        string division = centrodiv.IdDivision.ToString();
        string lineaFinal = linea ?? "Todo";
        string f1Final = f1 ?? DateTime.Today.ToString("dd-MM-yyyy");
        string f2Final = f2 ?? DateTime.Today.ToString("dd-MM-yyyy");
        string estFinal = est ?? "Todo";
        string codigoFinal = string.IsNullOrWhiteSpace(codigo) ? "Total Pendiente" : codigo;
        int responsableFinal = responsable ?? 0;
        int ksfFFinal = KsfF ?? 0;
        string ruta = "";

        if (tipo == 0 || tipo == 2)
        {
            ruta = $"{lang}/{(lang == "en" ? "remaining" : "pendientes")}/{accion}/{division}/{lineaFinal}/{f1Final}/{f2Final}/{tipo}/{estFinal}/{codigoFinal}/{responsableFinal}/{ksfFFinal}";
        }
        else if (tipo == 1)
        {
            ruta = $"{lang}/{(lang == "en" ? "meeting" : "reunion")}/{accion}/{division}/{lineaFinal}/{f1Final}/{f2Final}/{tipo}/{estFinal}";
        }
        NavigationManager.NavigateTo(ruta, true);
        DiscForm.IdCausaCal = currentIdCausaCal;
    }

    private async Task Editar()
    {
        try
        {
            // Validación de fechas y tipo
            if (DiscForm.RdfecTra >= DiscForm.RdfecReu && ((int)tipo == 0 || (int)tipo == 1 || (int)tipo == 2))
            {
                // Validación de límite de cambios de fecha
                if (CambiosFecha.Count() >= 3 && camFec != DiscForm.RdfecTra)
                {
                    NotificationService.Notify(Notificar.Notificacion("error", ValidationMessages.Atencion, ValidationMessages.Limite));
                    return;
                }

                // Validación de plan de acción vacío al cerrar
                if (string.IsNullOrEmpty(DiscForm.RdplanAcc) && DiscForm.Rdstatus == "Cerrado")
                {
                    NotificationService.Notify(Notificar.Notificacion("advertencia", ValidationMessages.Atencion, ValidationMessages.NPA1));
                    return;
                }

                // Validación de cambio de plan de acción a vacío
                if (PlanOld != DiscForm.RdplanAcc && string.IsNullOrEmpty(DiscForm.RdplanAcc))
                {
                    NotificationService.Notify(Notificar.Notificacion("advertencia", ValidationMessages.Atencion, ValidationMessages.NPA2));
                    DiscForm.RdplanAcc = PlanOld;
                    return;
                }

                // Registro de cambio de status
                if (camStat != DiscForm.Rdstatus)
                {
                    CambStat.IdReuDia = DiscForm.IdReuDia;
                    CambStat.Cbfecha = DateTime.Now;
                    CambStat.Cbstat = DiscForm.Rdstatus;
                    CambStat.Cbuser = $"{claims[2].Value} {claims[3].Value}";
                }

                // Registro de cambio de fecha
                if (camFec != DiscForm.RdfecTra)
                {
                    CambFec.IdReuDia = DiscForm.IdReuDia;
                    CambFec.Cffec = DateTime.Now;
                    CambFec.CffecNew = DiscForm.RdfecTra;
                    CambFec.Cfuser = $"{claims[2].Value} {claims[3].Value}";
                }

                // Guardar cambios
                var resultado = await PizarraData.UpdateDiscrepancia2(DiscForm, (int)Id);
                cambio = resultado.success;

                if (cambio)
                {
                    await AvisadorData.InsertCambioStatus(CambStat);
                    await AvisadorData.InsertCambioFec(CambFec);

                    // Construcción manual de la ruta
                    string lang = idPais == 5 ? "en" : "es";
                    string accion = resultado.centro ?? "1";
                    string division = resultado.division ?? "1";
                    string lineaFinal = linea ?? "Todo";
                    string f1Final = f1 ?? DateTime.Today.ToString("dd-MM-yyyy");
                    string f2Final = f2 ?? DateTime.Today.ToString("dd-MM-yyyy");
                    string estFinal = est ?? "Todo";
                    string codigoFinal = string.IsNullOrWhiteSpace(codigo) ? "Total Pendiente" : codigo;
                    int responsableFinal = responsable ?? 0;
                    int ksfFFinal = KsfF ?? 0;

                    string ruta = "";

                    if (tipo == 0 || tipo == 2)
                    {
                        ruta = $"{lang}/{(lang == "en" ? "remaining" : "pendientes")}/{accion}/{division}/{lineaFinal}/{f1Final}/{f2Final}/{tipo}/{estFinal}/{codigoFinal}/{responsableFinal}/{ksfFFinal}";
                    }
                    else if (tipo == 1)
                    {
                        ruta = $"{lang}/{(lang == "en" ? "meeting" : "reunion")}/{accion}/{division}/{lineaFinal}/{f1Final}/{f2Final}/{tipo}/{estFinal}";
                    }

                    NavigationManager.NavigateTo(ruta, true);
                }
                else
                {
                    NotificationService.Notify(Notificar.Notificacion("advertencia", ValidationMessages.FalloR, ValidationMessages.ErrorP));
                }
            }
            else
            {
                NotificationService.Notify(Notificar.Notificacion("advertencia", ValidationMessages.ERevisar, ValidationMessages.FechaMenor));
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(Notificar.Notificacion("error", ValidationMessages.ErrorInesp, ValidationMessages.Reload));
        }
}




