@page "/es/historicos"
@page "/en/historical"

@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject IMaestraData MaestraData
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService
@inject ILocalStorageService LocalStorage
@using System.Globalization
@using Radzen.Blazor
@using ReunionWeb.Resources
<h3>@ValidationMessages.Historicos</h3>


<BSContainer>

    @if (MaestraData.centro.Count() == 0)
    {
        <div class="loader"></div>
    }
    else
    {


        <BSRow>
            <BSCol Column="3" ColumnSmall="2">
                <BSLabel>@ValidationMessages.Centro</BSLabel>
                <BSInput InputType="InputType.Select" @onchange="BuscarDivision" @bind-Value="IdCentro">
                    <option value="0"> @ValidationMessages.Seleccione </option>
                    @foreach (var d in MaestraData.centro)
                    {
                        <option value="@d.IdCentro">@d.Centro</option>
                    }
                </BSInput>
            </BSCol>


            <BSCol Column="3" ColumnSmall="2">
                <BSLabel>@ValidationMessages.Division</BSLabel>
                <BSInput InputType="InputType.Select" @bind-Value="IdDiv">
                    <option value="0">@ValidationMessages.Seleccione</option>
                    @foreach (var d in MaestraData.divisions)
                    {
                        <option value="@d.IdDivision">@d.Ndivision</option>
                    }
                </BSInput>
            </BSCol>



            <BSCol Column="3" ColumnSmall="2">
                <BSLabel> @ValidationMessages.Desde</BSLabel>
                <BSInput InputType="InputType.Date" @bind-Value="fecha1" />
            </BSCol>

            <BSCol Column="3" ColumnSmall="2">
                <BSLabel>@ValidationMessages.Hasta</BSLabel>
                <BSInput InputType="InputType.Date" @bind-Value="fecha2" />
            </BSCol>

            <BSCol ColumnSmall="1" Column="2">
                <BSLabel>@ValidationMessages.Codigo</BSLabel>
                <BSInput InputType="InputType.Select" @bind-Value="Codigo">
                    <option value="Todo">@ValidationMessages.Todo</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                </BSInput>
            </BSCol>

            <BSCol ColumnSmall="2" Column="3">
                <BSLabel>@ValidationMessages.Estado</BSLabel>
                <BSInput InputType="InputType.Select" @bind-Value="Status">
                    <option value="Total Pendiente">@ValidationMessages.TotalPendiente</option>
                    <option value="Todo">@ValidationMessages.Todo</option>
                    <option value="Pendiente">@ValidationMessages.Pendiente</option>
                    <option value="Pendiente/Responsable">@ValidationMessages.Pendiente / @ValidationMessages.Responsable</option>
                    <option value="No Conforme">@ValidationMessages.NoConforme</option>
                    <option value="Listo">@ValidationMessages.Listo</option>
                    <option value="Cerrado">@ValidationMessages.Cerrado</option>
                    <option value="Vencidos">@ValidationMessages.Vencidos</option>
                </BSInput>
            </BSCol>

        </BSRow>
        <p>
        </p>
        <BSRow>

            <BSCol ColumnSmall="2" Column="1">
                <BSRow>
                    <BSLabel>@ValidationMessages.FiltroFechaDeTrabajo</BSLabel>
                </BSRow>
                <BSInputRadio CheckedValue="@("2")" @bind-Value="tipoconsulta" IsToggle="true" Size="Size.ExtraSmall"
                    Color="BSColor.Success" IsOutlined="true">
                    @ValidationMessages.FechaDelTrabajo
                    <span class="oi oi-cog"></span>
                </BSInputRadio>
            </BSCol>

            <BSCol ColumnSmall="2" Column="1">
                <BSRow>
                    <BSLabel> @ValidationMessages.FiltroFechaDeReunion</BSLabel>
                </BSRow>
                <BSInputRadio CheckedValue="@("0")" @bind-Value="tipoconsulta" IsToggle="true" Size="Size.ExtraSmall"
                    Color="BSColor.Success" IsOutlined="true">
                    @ValidationMessages.FechaDeReunion
                    <span class="oi oi-people"></span>
                </BSInputRadio>
            </BSCol>

            <BSCol ColumnSmall="2" Column="2">
                <BSRow>
                    <BSLabel>@ValidationMessages.Buscar</BSLabel>
                </BSRow>
                <BSButton IsOutlined Color="BSColor.Success" Size="Size.ExtraSmall" OnClick="Get"> @ValidationMessages.Consultar <span
                        class="oi oi-check"></span></BSButton>
            </BSCol>

        </BSRow>
    }

</BSContainer>

<p></p>

@if (tabla.Count() > 0 && dataIsLoaded == 2)
{

    <RadzenDataGrid @ref="@ReuTabla" Data="@tabla" class="rz-shadow-2" AllowFiltering="true" AllowColumnResize="true"
        AllowAlternatingRows="true" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="30" AllowPaging="true"
        PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" TItem="ReunionDTO"
        LogicalFilterOperator="LogicalFilterOperator.Or" OrOperatorText="O" AndOperatorText="Y" EqualsText="Igual a"
        EditMode="DataGridEditMode.Single" ColumnWidth="200px">
        <Columns>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="#" Frozen="true" Width="35px" Filterable=false>
                <Template>

                    @(tabla.IndexOf(context) + 1)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.Linea" Frozen="true" Property="Rdarea" Width="80px">
                <Template>
                    @context.Rdarea
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.CodigoDeEquipo" Frozen="true" Property="RdcodEq" Width="80px">
                <Template>
                    @context.RdcodEq
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.NombreDelEquipo" Frozen="true" Property="RdcodEq" Width="80px">
                <Template Context="context">
                    @(string.IsNullOrWhiteSpace(context.EnombreEam) ? "EQUIPO NO ENCONTRADO" : context.EnombreEam)
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="KSF" Property="Ksf" Width="80px">
                <Template>
                    @context.Ksf
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.Discrepancia" Property="Rddisc" Width="220px">
                <Template>
                    @context.Rddisc
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.Codigo" Property="RdcodDis" Width="60px">
                <Template>
                    @context.RdcodDis
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.Accion" Property="RdplanAcc" Width="200px">
                <Template>
                    @context.RdplanAcc
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.Tiempo" Property="Rdtiempo" Width="60px">
                <Template>
                    @context.Rdtiempo
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.Responsable" Property="Responsable" Width="100px">
                <Template>
                    @context.Responsable
                </Template>
            </RadzenDataGridColumn>


            <RadzenDataGridColumn TItem="ReunionDTO" Title="Requisición" Property="Rdodt" Width="100px">

                <Template>
                    @if (context.RdcodRequi == null)
                    {
                        <span>N/A</span>
                    }
                    else
                    {
                        <span>@context.RdcodRequi</span>
                    }
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="ODT" Property="Rdodt" Width="100px">
                <Template>
                    @context.Rdodt
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.Estado" Property="Rdstatus" Width="90px">
                <Template>
                    @ValidationMessages.ResourceManager.GetString(context.Rdstatus, CultureInfo.CurrentUICulture)
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.FechaDeReunion" Property="RdfecReu" Width="90px">
                <Template>
                    @context.RdfecReu.ToString("yyyy/MM/dd")
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@ValidationMessages.FechaDelTrabajo" Property="RdfecTra" Width="90px">
                <Template>
                    @context.RdfecTra.ToString("yyyy/MM/dd")
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

}
else if (dataIsLoaded == 1 && tabla.Count() == 0)
{
    <div class="loader"></div>
}
else if (dataIsLoaded == 2 && tabla.Count() == 0)
{
<div style="text-align: center; padding: 20px; font-size: 18px; color: rgb(102, 101, 101);">
    <p>@ValidationMessages.NoHayDatos</p>
</div>
}
@code {
            [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private int idPais { get; set; }
    RadzenDataGrid<ReunionDTO> ReuTabla;
    List<ReunionDTO> tabla = new List<ReunionDTO>();
    private NotifiRadzen Notificar = new NotifiRadzen();

    int dataIsLoaded = 0;
    string ayer = DateTime.Now.AddDays(-1).ToString("yyyyMMdd"), error;
    private bool data { get; set; } = false; //Centro


    [Required(ErrorMessage = "Seleccione el Centro")]
    private int IdCentro { get; set; } = 0; //id del Centro
    [Required(ErrorMessage = "Seleccione la división.")]
    private int IdDiv { get; set; } = 0; //id de la division

    private int CentroComedor;//Variable para verificar si es el comedor venezuela;

    //private string Div { get; set; } //Centro
    //private string Division { get; set; } //División

    private string Codigo { get; set; } = "Todo"; //Codigo
    private string Status { get; set; } = "Total Pendiente"; //Status
    private string UsrAdmin { get; set; } = ""; //permisos de admin
    private string UsrRol { get; set; } = ""; //rol para filtrar
    private bool cargandocambio { get; set; } = false; //para cargar los datos del trazabilidad
    private string tipoconsulta { get; set; } = "0"; //1-fecha de reuinion 0 fecha trabajo
    private List<Claim> claims { get; set; }
    public DateTime fecha1;
    public DateTime fecha2;

    private string mensaje = "";





    private async Task CreateData()

    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        fecha1 = DateTime.Now;
        fecha2 = DateTime.Now;
        await CreateData();

                var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        int paisTemp;

        if (int.TryParse(idPaisClaim, out paisTemp) && paisTemp == 5)
        {
            idPais = paisTemp;
            var culture = new System.Globalization.CultureInfo("en");
            System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
            await LocalStorage.SetItemAsync("userCulture", "en");
        }
        else
        {
            var culture = new System.Globalization.CultureInfo("es");
            System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
            await LocalStorage.SetItemAsync("userCulture", "es");
        }

        var rol = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value;

        //TODO: Crear logica con funcion qur retorne esto.se usa en hoistoricos tambien
        switch (claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value)
        {
            case "Admin":
            case "SuperAdmin":
            case "PrimeUser":
                UsrAdmin = "SuperAdmin";
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            case "SemiAdmin":
                UsrAdmin = "SemiAdmin";
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            case "Planificador":
            case "SuperUser":
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            case "Auditores":
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            case "MttoAdmin":
                UsrRol = "Mtto";
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;
            case "SeguridadAdmin":
                UsrRol = "Seguridad";//Seguridad para filtar por seguridad
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;
            case "CalidadAdmin":
                UsrRol = "Calidad";//Seguridad para filtar por calidad
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;
            case "Mantenimiento":
                UsrRol = "Mtto";
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            default:
                UsrRol = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value;
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;
        }


        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        PizarraData.reudiatablas = new List<ReunionDTO>();


    }
    protected async Task BuscarDivision(ChangeEventArgs e)
    {
        IdCentro = int.Parse(e.Value.ToString());
        IdDiv = 0;
        try
        {
            if (IdCentro != 0)
            {
                MaestraData.divisions = await MaestraData.ObtenerDivisionDelCentro(IdCentro);
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error: " + ex.Message;
        }
    }
    protected async Task Get()
    {
        if (IdCentro != 0 & IdDiv != 0)
        {
            if (dataIsLoaded != 1)
            {
                dataIsLoaded = 1;
                tabla = await PizarraData.GetHistoricos(IdCentro.ToString(), IdDiv.ToString(), fecha1, fecha2, tipoconsulta, Uri.EscapeDataString(Status));
                foreach (var d in tabla)
                {
                    d.Ksf = KsfData.ksfs.Where(x => x.Idksf == d.Idksf).Select(x => idPais == 5 ? x.KsfEnglish : x.KsfNombre).FirstOrDefault();
                    var nombreOriginal = RespoReuData.resporeus.Where(x => x.IdResReu == d.IdResReu).FirstOrDefault()?.Rrnombre ?? "";
                    d.Responsable = ValidationMessages.ResourceManager.GetString(ValidationMessages.MapResponsableKey(nombreOriginal),CultureInfo.CurrentUICulture);
                }

                dataIsLoaded = 2;
            }
        }
        else
        {
            mensaje = "Verifique todos los campos";
            NotificationService.Notify(Notificar.Notificacion("advertencia", mensaje, ""));
        }
    }
}
