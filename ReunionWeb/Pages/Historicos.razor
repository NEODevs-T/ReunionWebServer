@page "/es/historicos"
@page "/en/historical"

@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject IMaestraData MaestraData
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService
@inject ILocalStorageService LocalStorage
@inject IDiccionarioTraduccionesService DiccionarioTraduccionesService
@inject LocalizationService LocalizationService
@inject ITranslationService Translator


@using ReunionWeb.Resources
@using System.Globalization
@using ReunionWeb.Services
@using Radzen.Blazor


@if (!traduccionesCargadas || MaestraData.centro.Count() == 0)
{
    <div class="loader"></div>
}
else
{
<h3>@DiccionarioTraduccionesService.Traducciones["Historicos"]</h3>


<BSContainer>

    @if (MaestraData.centro.Count() == 0)
    {
        <div class="loader"></div>
    }
    else
    {


        <BSRow>
            <BSCol Column="3" ColumnSmall="2">
                <BSLabel>@DiccionarioTraduccionesService.Traducciones["Centro"]</BSLabel>
                <BSInput InputType="InputType.Select" @onchange="BuscarDivision" @bind-Value="IdCentro">
                    <option value="0"> @DiccionarioTraduccionesService.Traducciones["Seleccione"] </option>
                    @foreach (var d in MaestraData.centro)
                    {
                        <option value="@d.IdCentro">@d.Centro</option>
                    }
                </BSInput>
            </BSCol>


            <BSCol Column="3" ColumnSmall="2">
                <BSLabel>@DiccionarioTraduccionesService.Traducciones["Division"]</BSLabel>
                <BSInput InputType="InputType.Select" @bind-Value="IdDiv">
                    <option value="0">@DiccionarioTraduccionesService.Traducciones["Seleccione"]</option>
                    @foreach (var d in MaestraData.divisions)
                    {
                        <option value="@d.IdDivision">@d.Ndivision</option>
                    }
                </BSInput>
            </BSCol>



            <BSCol Column="3" ColumnSmall="2">
                <BSLabel> @DiccionarioTraduccionesService.Traducciones["Desde"]</BSLabel>
                <BSInput InputType="InputType.Date" @bind-Value="fecha1" />
            </BSCol>

            <BSCol Column="3" ColumnSmall="2">
                <BSLabel>@DiccionarioTraduccionesService.Traducciones["Hasta"]</BSLabel>
                <BSInput InputType="InputType.Date" @bind-Value="fecha2" />
            </BSCol>

            <BSCol ColumnSmall="1" Column="2">
                <BSLabel>@DiccionarioTraduccionesService.Traducciones["Codigo"]</BSLabel>
                <BSInput InputType="InputType.Select" @bind-Value="Codigo">
                    <option value="Todo">@DiccionarioTraduccionesService.Traducciones["Todo"]</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                </BSInput>
            </BSCol>

            <BSCol ColumnSmall="2" Column="3">
                <BSLabel>@DiccionarioTraduccionesService.Traducciones["Estado"]</BSLabel>
                <BSInput InputType="InputType.Select" @bind-Value="Status">
                    <option value="Total Pendiente">@DiccionarioTraduccionesService.Traducciones["TotalPendiente"]</option>
                    <option value="Todo">@DiccionarioTraduccionesService.Traducciones["Todo"]</option>
                    <option value="Pendiente">@DiccionarioTraduccionesService.Traducciones["Pendiente"]</option>
                    <option value="Pendiente/Responsable">@DiccionarioTraduccionesService.Traducciones["Pendiente"] / @DiccionarioTraduccionesService.Traducciones["Responsable"]</option>
                    <option value="No Conforme">@DiccionarioTraduccionesService.Traducciones["NoConforme"]</option>
                    <option value="Listo">@DiccionarioTraduccionesService.Traducciones["Listo"]</option>
                    <option value="Cerrado">@DiccionarioTraduccionesService.Traducciones["Cerrado"]</option>
                    <option value="Vencidos">@DiccionarioTraduccionesService.Traducciones["Vencidos"]</option>
                </BSInput>
            </BSCol>

        </BSRow>
        <p>
        </p>
        <BSRow>

            <BSCol ColumnSmall="2" Column="1">
                <BSRow>
                    <BSLabel>@DiccionarioTraduccionesService.Traducciones["FiltroFechaDeTrabajo"]</BSLabel>
                </BSRow>
                <BSInputRadio CheckedValue="@("2")" @bind-Value="tipoconsulta" IsToggle="true" Size="Size.ExtraSmall"
                    Color="BSColor.Success" IsOutlined="true">
                    @DiccionarioTraduccionesService.Traducciones["FechaDelTrabajo"]
                    <span class="oi oi-cog"></span>
                </BSInputRadio>
            </BSCol>

            <BSCol ColumnSmall="2" Column="1">
                <BSRow>
                    <BSLabel> @DiccionarioTraduccionesService.Traducciones["FiltroFechaDeReunion"]</BSLabel>
                </BSRow>
                <BSInputRadio CheckedValue="@("0")" @bind-Value="tipoconsulta" IsToggle="true" Size="Size.ExtraSmall"
                    Color="BSColor.Success" IsOutlined="true">
                    @DiccionarioTraduccionesService.Traducciones["FechaDeReunion"]
                    <span class="oi oi-people"></span>
                </BSInputRadio>
            </BSCol>

            <BSCol ColumnSmall="2" Column="2">
                <BSRow>
                    <BSLabel>@DiccionarioTraduccionesService.Traducciones["Buscar"]</BSLabel>
                </BSRow>
                <BSButton IsOutlined Color="BSColor.Success" Size="Size.ExtraSmall" OnClick="Get"> @DiccionarioTraduccionesService.Traducciones["Consultar"] <span
                        class="oi oi-check"></span></BSButton>
            </BSCol>

        </BSRow>
    }

</BSContainer>

<p></p>

@if (tabla.Count() > 0 && dataIsLoaded == 2)
{

    <RadzenDataGrid @ref="@ReuTabla" Data="@tabla" class="rz-shadow-2" AllowFiltering="true" AllowColumnResize="true"
        AllowAlternatingRows="true" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="30" AllowPaging="true"
        PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true" TItem="ReunionDTO"
        LogicalFilterOperator="LogicalFilterOperator.Or" OrOperatorText="O" AndOperatorText="Y" EqualsText="Igual a"
        EditMode="DataGridEditMode.Single" ColumnWidth="200px">
        <Columns>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="#" Frozen="true" Width="35px" Filterable=false>
                <Template>

                    @(tabla.IndexOf(context) + 1)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["Linea"]" Frozen="true" Property="Rdarea" Width="80px">
                <Template>
                    @context.Rdarea
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]" Frozen="true" Property="RdcodEq" Width="80px">
                <Template>
                    @context.RdcodEq
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["NombreDelEquipo"]" Frozen="true" Property="RdcodEq" Width="80px">
                <Template Context="context">
                    @(string.IsNullOrWhiteSpace(context.EnombreEam) ? "EQUIPO NO ENCONTRADO" : context.EnombreEam)
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="KSF" Property="Ksf" Width="80px">
                <Template>
                    @context.Ksf
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["Discrepancia"]" Property="Rddisc" Width="220px">
                <Template>
                    @context.Rddisc
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["Codigo"]" Property="RdcodDis" Width="60px">
                <Template>
                    @context.RdcodDis
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["Accion"]" Property="RdplanAcc" Width="200px">
                <Template>
                    @context.RdplanAcc
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["Tiempo"]" Property="Rdtiempo" Width="60px">
                <Template>
                    @context.Rdtiempo
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["Responsable"]" Property="Responsable" Width="100px">
                <Template>
                    @DiccionarioTraduccionesService.Traducciones[context.Responsable]
                </Template>
            </RadzenDataGridColumn>


            <RadzenDataGridColumn TItem="ReunionDTO" Title="Requisición" Property="Rdodt" Width="100px">

                <Template>
                    @if (context.RdcodRequi == null)
                    {
                        <span>N/A</span>
                    }
                    else
                    {
                        <span>@context.RdcodRequi</span>
                    }
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="ODT" Property="Rdodt" Width="100px">
                <Template>
                    @context.Rdodt
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["Estado"]" Property="Rdstatus" Width="90px">
                <Template>
                @{
                    var clave = context.Rdstatus;
                    var traduccion = DiccionarioTraduccionesService.Traducciones.ContainsKey(clave)
                    ? DiccionarioTraduccionesService.Traducciones[clave]
                    : clave;
                }
                <span>@traduccion</span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["FechaDeReunion"]" Property="RdfecReu" Width="90px">
                <Template>
                    @context.RdfecReu.ToString("yyyy/MM/dd")
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["FechaDelTrabajo"]" Property="RdfecTra" Width="90px">
                <Template>
                    @context.RdfecTra.ToString("yyyy/MM/dd")
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

}
else if (dataIsLoaded == 1 && tabla.Count() == 0)
{
    <div class="loader"></div>
}
else if (dataIsLoaded == 2 && tabla.Count() == 0)
{
<div style="text-align: center; padding: 20px; font-size: 18px; color: rgb(102, 101, 101);">
    <p>@DiccionarioTraduccionesService.Traducciones["NoHayDatos"]</p>
</div>
}
}
@code {
            [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private int idPais { get; set; }
    RadzenDataGrid<ReunionDTO> ReuTabla;
    List<ReunionDTO> tabla = new List<ReunionDTO>();
    private NotifiRadzen Notificar = new NotifiRadzen();

    int dataIsLoaded = 0;
    string ayer = DateTime.Now.AddDays(-1).ToString("yyyyMMdd"), error;
    private bool data { get; set; } = false; //Centro


    [Required(ErrorMessage = "Seleccione el Centro")]
    private int IdCentro { get; set; } = 0; //id del Centro
    [Required(ErrorMessage = "Seleccione la división.")]
    private int IdDiv { get; set; } = 0; //id de la division

    private int CentroComedor;//Variable para verificar si es el comedor venezuela;

    //private string Div { get; set; } //Centro
    //private string Division { get; set; } //División

    private string Codigo { get; set; } = "Todo"; //Codigo
    private string Status { get; set; } = "Total Pendiente"; //Status
    private string UsrAdmin { get; set; } = ""; //permisos de admin
    private string UsrRol { get; set; } = ""; //rol para filtrar
    private bool cargandocambio { get; set; } = false; //para cargar los datos del trazabilidad
    private string tipoconsulta { get; set; } = "0"; //1-fecha de reuinion 0 fecha trabajo
    private List<Claim> claims { get; set; }
    public DateTime fecha1;
    public DateTime fecha2;
    private bool traduccionesCargadas = false;
    private string mensaje = "";





    private async Task CreateData()

    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);
        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        fecha1 = DateTime.Now;
        fecha2 = DateTime.Now;
        await CreateData();
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;

        var rol = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value;

        //TODO: Crear logica con funcion qur retorne esto.se usa en hoistoricos tambien
        switch (claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value)
        {
            case "Admin":
            case "SuperAdmin":
            case "PrimeUser":
                UsrAdmin = "SuperAdmin";
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            case "SemiAdmin":
                UsrAdmin = "SemiAdmin";
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            case "Planificador":
            case "SuperUser":
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            case "Auditores":
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            case "MttoAdmin":
                UsrRol = "Mtto";
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;
            case "SeguridadAdmin":
                UsrRol = "Seguridad";//Seguridad para filtar por seguridad
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;
            case "CalidadAdmin":
                UsrRol = "Calidad";//Seguridad para filtar por calidad
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;
            case "Mantenimiento":
                UsrRol = "Mtto";
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            default:
                UsrRol = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value;
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;
        }


        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        PizarraData.reudiatablas = new List<ReunionDTO>();


    }
    protected async Task BuscarDivision(ChangeEventArgs e)
    {
        IdCentro = int.Parse(e.Value.ToString());
        IdDiv = 0;
        try
        {
            if (IdCentro != 0)
            {
                MaestraData.divisions = await MaestraData.ObtenerDivisionDelCentro(IdCentro);
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error: " + ex.Message;
        }
    }
    protected async Task Get()
    {
        if (IdCentro != 0 & IdDiv != 0)
        {
            if (dataIsLoaded != 1)
            {
                dataIsLoaded = 1;
                tabla = await PizarraData.GetHistoricos(IdCentro.ToString(), IdDiv.ToString(), fecha1, fecha2, tipoconsulta, Uri.EscapeDataString(Status));
                foreach (var d in tabla)
                {
                    d.Ksf = KsfData.ksfs.Where(x => x.Idksf == d.Idksf).Select(x => idPais == 5 ? x.KsfEnglish : x.KsfNombre).FirstOrDefault();
                    var nombreOriginal = RespoReuData.resporeus.Where(x => x.IdResReu == d.IdResReu).FirstOrDefault()?.Rrnombre ?? "";
                    var clave = ValidationMessages.MapResponsableKey(nombreOriginal);
                    d.Responsable = clave; 
                }

                dataIsLoaded = 2;
            }
        }
        else
        {
            mensaje = DiccionarioTraduccionesService.Traducciones["VerifiqueCampos"];
            NotificationService.Notify(Notificar.Notificacion("advertencia", mensaje, ""));
        }
    }
}
