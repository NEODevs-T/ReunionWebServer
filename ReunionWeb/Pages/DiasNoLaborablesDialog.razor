@using Radzen
@inject DialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject IDiccionarioTraduccionesService DiccionarioTraduccionesService
@inject LocalizationService LocalizationService
@inject ITranslationService Translator

@using System.Globalization
@using ReunionWeb.Resources
@using ReunionWeb.Services



    <div>
        <RadzenLabel Text="@DiccionarioTraduccionesService.Traducciones["SeleccioneDML"]" />
        <RadzenDatePicker TValue="DateTime?" @bind-Value="fechaTemp"
                        DateFormat="dd-MM-yyyy"
                        Max="@FechaMaxima"
                        Style="width: 100%;" />

        <RadzenButton Text="@DiccionarioTraduccionesService.Traducciones["AgregarFecha"]"
                    Icon="add"
                    Style="margin-top: 10px; margin-bottom: 10px;"
                    Click="AgregarFecha" />

        <RadzenLabel Text="@DiccionarioTraduccionesService.Traducciones["FechasSeleccionadas"]" style="margin-top: 8px;" />
        <ul>
            @foreach (var fecha in fechasTemp.OrderBy(f => f))
            {
                <li>
                    @fecha.ToString("dd-MM-yyyy")
                    <RadzenButton Icon="close"
                                ButtonStyle="ButtonStyle.Danger"
                                Size="ButtonSize.Small"
                                Click="() => EliminarFecha(fecha)"
                                style="margin-left:5px;" />
                </li>
            }
        </ul>

        <div style="margin-top: 10px;">
            <RadzenButton Text="@DiccionarioTraduccionesService.Traducciones["Guardar"]"
                        Click="Guardar"
                        Style="margin-right: 10px;" />
            <RadzenButton Text="@DiccionarioTraduccionesService.Traducciones["Cancelar"]"
                        ButtonStyle="ButtonStyle.Secondary"
                        Click="() => DialogService.Close()" />
        </div>
    </div>


@code {
            [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private int idPais { get; set; }
    [Parameter] public List<DateTime> FechasIniciales { get; set; } = new();
    [Parameter] public DateTime FechaMaxima { get; set; }
    private List<DateTime> fechasTemp = new();
    private DateTime? fechaTemp;
    private List<Claim> claims { get; set; }
    private bool traduccionesCargadas = false;

        private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = user.Claims.ToList();
    }

        protected override async Task OnInitializedAsync()
    {
                await CreateData();
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;
    }

    protected override void OnInitialized()
    {
        fechasTemp = new List<DateTime>(FechasIniciales);
    }

    void AgregarFecha()
    {
        if (fechaTemp.HasValue && !fechasTemp.Contains(fechaTemp.Value.Date))
        {
            fechasTemp.Add(fechaTemp.Value.Date);
        }
    }

    void EliminarFecha(DateTime fecha)
    {
        fechasTemp.Remove(fecha);
    }

    void Guardar()
    {
        DialogService.Close(fechasTemp);
    }
}
