@page "/asistencia"

@inject IDbReunionService DbReunionService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAPIReunionService APIReunionService
@inject ILocalStorageService LocalStorage
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin, AdminChempro, SupIntendente, SupIntendenteGeneral, SuperAdmin")]

@if(idPais == TrinidadYTobago){
    <h3>Attendance</h3>
    <p></p>


    <BSContainer>

        @if (APIReunionService.centro.Count() == 0)
        {
            <div class="loader"></div>
        }
        else
        {

            <BSRow>
                <BSCol Column="4">

                    <BSInput InputType="InputType.Select" @bind-Value="Div">
                        @foreach (var d in APIReunionService.centro)
                        {
                        <option value="@d.Cnom">@d.Cnom</option>
                        }
                </BSInput>
            </BSCol>

            <BSCol ColumnSmall="3">
                <BSButton IsOutlined Color="BSColor.Success" Size="Size.ExtraSmall" @onclick="Get">   Assistants  <span class="oi oi-check"></span></BSButton>
            </BSCol>

        </BSRow>

        }

    </BSContainer>

    <p></p>


    @if (APIReunionService.cargoreus.Count() > 0 && dataIsLoaded == 2)
    {
        @if (listaAsistencia.Where(c => c.AridCargoRNavigation.Crbloque == 1).Count() > 0)
        {
            <BSCol Column="4">
                <BSLabel>Block: @bloque</BSLabel>
                <BSInput InputType="InputType.Range" step="1" min="1" max="3" @bind-Value="bloque" />
            </BSCol>
        }

        <BSCol Column="6">
            <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
                <BSTHead Class="cabecera">
                    <BSTR>
                        <BSTD>Personally</BSTD>
                        <BSTD>Presence</BSTD>
                        <BSTD>Substitution</BSTD>
                    </BSTR>
                </BSTHead>
                <BSTBody>
                    @if (listaAsistencia.Where(c=>c.AridCargoRNavigation.Crbloque ==1).Count()>0)
                    {
                    
                        @foreach (var d in listaAsistencia.Where(c => c.AridCargoRNavigation.Crbloque == bloque))
                        {


                            <BSTR>

                                <BSTD>@d.AridCargoRNavigation.Crnombre</BSTD>
                                <BSTD>
                                    <div Class="@BS.Form_Check @BS.Form_Switch">
                                        <BSInputCheckbox CheckedValue="@(1)" UnCheckedValue="@(0)"  Color="BSColor.Success" @bind-Value="d.ArAsistente" />
                                        <BSLabel IsCheckLabel="true">

                                        </BSLabel>
                                    </div>
                                </BSTD>
                                <BSTD>
                                    <div Class="@BS.Form_Check">
                                        <BSInputCheckbox CheckedValue="@(1)" UnCheckedValue="@(0)"  @bind-Value="d.ArSuplente" />

                                    </div>
                                </BSTD>

                            </BSTR>
                        }
                    }
                    else
                    {
                        @foreach (var d in listaAsistencia)
                        {


                            <BSTR>

                            <BSTD>@d.AridCargoRNavigation.Crnombre</BSTD>
                            <BSTD>
                                <div Class="@BS.Form_Check @BS.Form_Switch">
                                    <BSInputCheckbox CheckedValue="@(1)"  UnCheckedValue="@(0)"  Color="BSColor.Success" @bind-Value="d.ArAsistente" />
                                    <BSLabel IsCheckLabel="true">

                                    </BSLabel>
                                </div>
                            </BSTD>
                            <BSTD>
                                <div Class="@BS.Form_Check">
                                    <BSInputCheckbox CheckedValue="@(1)" UnCheckedValue="@(0)"  @bind-Value="d.ArSuplente" />
                                
                                </div>
                            </BSTD>

                        </BSTR>
                        }

                    }
                </BSTBody>

            </BSTable>
            <BSButton IsOutlined Color="BSColor.Success" Size="Size.ExtraSmall" @onclick="Save">   Save  <span class="oi oi-check"></span></BSButton>
        </BSCol>


    }
    else if (APIReunionService.cargoreus.Count() == 0 && dataIsLoaded == 2)
    {
        <p>No personnel have been charged at this center.</p>
    }
    else if (dataIsLoaded == 1 && APIReunionService.cargoreus.Count() == 0)
    {
        <div class="loader"></div>
    }

}else{
        
    <h3>Asistencia</h3>
    <p></p>


    <BSContainer>

        @if (APIReunionService.centro.Count() == 0)
        {
            <div class="loader"></div>
        }
        else
        {

            <BSRow>
                <BSCol Column="4">

                    <BSInput InputType="InputType.Select" @bind-Value="Div">
                        @foreach (var d in APIReunionService.centro)
                        {
                        <option value="@d.Cnom">@d.Cnom</option>
                        }
                </BSInput>
            </BSCol>

            <BSCol ColumnSmall="3">
                <BSButton IsOutlined Color="BSColor.Success" Size="Size.ExtraSmall" @onclick="Get">   Asistentes  <span class="oi oi-check"></span></BSButton>
            </BSCol>

        </BSRow>

        }

    </BSContainer>

    <p></p>


    @if (APIReunionService.cargoreus.Count() > 0 && dataIsLoaded == 2)
    {
        @if (listaAsistencia.Where(c => c.AridCargoRNavigation.Crbloque == 1).Count() > 0)
        {
            <BSCol Column="4">
                <BSLabel>Bloque: @bloque</BSLabel>
                <BSInput InputType="InputType.Range" step="1" min="1" max="3" @bind-Value="bloque" />
            </BSCol>
        }

        <BSCol Column="6">
            <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
                <BSTHead Class="cabecera">
                    <BSTR>
                        <BSTD>Personal</BSTD>
                        <BSTD>Presencia</BSTD>
                        <BSTD>Suplencia</BSTD>
                    </BSTR>
                </BSTHead>
                <BSTBody>
                    @if (listaAsistencia.Where(c=>c.AridCargoRNavigation.Crbloque ==1).Count()>0)
                    {
                    
                        @foreach (var d in listaAsistencia.Where(c => c.AridCargoRNavigation.Crbloque == bloque))
                        {


                            <BSTR>

                                <BSTD>@d.AridCargoRNavigation.Crnombre</BSTD>
                                <BSTD>
                                    <div Class="@BS.Form_Check @BS.Form_Switch">
                                        <BSInputCheckbox CheckedValue="@(1)" UnCheckedValue="@(0)" Color="BSColor.Success" @bind-Value="d.ArAsistente" />
                                        <BSLabel IsCheckLabel="true">

                                        </BSLabel>
                                    </div>
                                </BSTD>
                                <BSTD>
                                    <div Class="@BS.Form_Check">
                                        <BSInputCheckbox CheckedValue="@(1)" UnCheckedValue="@(0)"  @bind-Value="d.ArSuplente" />

                                    </div>
                                </BSTD>

                            </BSTR>
                        }
                    }
                    else
                    {
                        @foreach (var d in listaAsistencia)
                        {


                            <BSTR>

                            <BSTD>@d.AridCargoRNavigation.Crnombre</BSTD>
                            <BSTD>
                                <div Class="@BS.Form_Check @BS.Form_Switch">
                                    <BSInputCheckbox CheckedValue="@(1)"  UnCheckedValue="@(0)"  Color="BSColor.Success" @bind-Value="d.ArAsistente" />
                                    <BSLabel IsCheckLabel="true">

                                    </BSLabel>
                                </div>
                            </BSTD>
                            <BSTD>
                                <div Class="@BS.Form_Check">
                                    <BSInputCheckbox CheckedValue="@(1)" UnCheckedValue="@(0)"   @bind-Value="d.ArSuplente" />
                                
