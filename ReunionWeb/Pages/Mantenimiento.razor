@code {

    private List<Claim> claims { get; set; }
    private int tipo { get; set; } = 0;
    private int idCent { get; set; } = 0;
    private int idDiv { get; set; } = 0;
    private int idLin { get; set; } = 0;
    private DateTime? fecha1 { get; set; } = null;
    private DateTime? fecha2 { get; set; } = null;
    private DateTime _fecha1 { get; set; }
    private DateTime _fecha2 { get; set; }
    private int ventanaModal = 0;
    private string mensaje { get; set; }
    private string UsrRol { get; set; }
    int dataIsLoaded = 0;
    int punto = 0;
    FechaProgDTO fechaProg { get; set; } = new FechaProgDTO()
        {
        Fpprogra = DateTime.Today
    };
    List<FechaProgDTO> lisFechaProg { get; set; } = new List<FechaProgDTO>();
    private int idFechaPro { get; set; } = 0;//id para mostar los campos de edicion
    private NotifiRadzen Notificar = new NotifiRadzen();//Logic para crear las noyificaciones radzen
    private string FechProFiltro { get; set; } = "";
    private bool traduccionesCargadas = false;
    private int idPais { get; set; }
    private bool mostrarInactivos = true;
    



    private readonly Dictionary<int, FechaProgDTO> _snapshotsFechas = new();

    private static FechaProgDTO CloneFecha(FechaProgDTO f) => new()
    {
        IdFechaPr = f.IdFechaPr,
        IdMaster  = f.IdMaster,
        Fpprogra  = f.Fpprogra,
        Fpdesc    = f.Fpdesc,
        Fpestado  = f.Fpestado,
        Fpcrea    = f.Fpcrea,
        Fpmodic   = f.Fpmodic,
        linea     = f.linea
    };

    private static void CopyFecha(FechaProgDTO src, FechaProgDTO dst)
    {
        dst.Fpprogra = src.Fpprogra;
        dst.Fpdesc   = src.Fpdesc;
        dst.Fpestado = src.Fpestado;
    }

    protected async Task OnLineaChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (!int.TryParse(value, out var lineaSeleccionada))
        {
            fechaProg.IdMaster = 0;
            return;
        }

        idLin = lineaSeleccionada;

        if (idLin == 0)
        {
            fechaProg.IdMaster = 0;
            return;
        }

        await MaestraData.GetMaestraXLinea(idLin);

        var master = MaestraData.maestra
            .FirstOrDefault(m => m.IdLinea == idLin);

        fechaProg.IdMaster = master?.IdMaster ?? 0;
    }

    protected override async Task OnInitializedAsync()
    {

        await CreateData();
        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;

        if (claims != null && claims.Count > 1 && (claims[1]?.Value == "Admin" || claims[1]?.Value == "SuperAdmin"))
        {

            await MaestraData.GetCentrosxEmpresa("All" + claims[10].Value);
        }
        else
        {
            await MaestraData.GetCentrosxEmpresa(claims[11].Value);
        }

        idCent = 0;
        idDiv = 0;
        idLin = 0; ;

        RespoReuData.resporeus = RespoReuData.resporeus.Where(a => a.Rrdesc == claims.FirstOrDefault(c =>
        c.Type.Contains("Empresa"))?.Value || string.IsNullOrEmpty(a.Rrdesc)).ToList();
    }

    private async Task CreateData()

    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);
        UsrRol = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value;
        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }

    }

    protected async Task BuscarDivision(ChangeEventArgs e)
    {
        idCent = int.Parse(e.Value.ToString());
        idDiv = 0;
        idLin = 0;
        try
        {
            if (idCent != 0)
            {
                MaestraData.divisions = await MaestraData.ObtenerDivisionDelCentro(idCent);
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error: " + ex.Message;
        }
    }

    protected async Task BuscarLinea(ChangeEventArgs e)
    {
        idDiv = int.Parse(e.Value.ToString());
        idLin = 0;
        fechaProg.IdMaster = 0;

        try
        {
            if (idDiv != 0)
            {
                MaestraData.lineas =
                    await MaestraData.ObtenerLasLineasPorDivision(idDiv);
            }
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
        }
    }

    protected async Task SaveFT(EditContext e)
    {
        if (!e.Validate())
            return;

        if (fechaProg.IdMaster == 0)
        {
            NotificationService.Notify(
                Notificar.Notificacion(
                    "advertencia",
                    DiccionarioTraduccionesService.Traducciones["Atencion"],
                    DiccionarioTraduccionesService.Traducciones["VerifiqueCampos"]
                ));
            return;
        }

        try
        {
            fechaProg.Fpcrea  = DateTime.Now;
            fechaProg.Fpmodic = DateTime.Now;
            fechaProg.Fpestado = true;

            var lista = new List<FechaProgDTO> { fechaProg };

            bool band = await MaestraData.AddFechaTrabajo(lista);

            if (band)
            {
                NotificationService.Notify(
                    Notificar.Notificacion(
                        "exito",
                        DiccionarioTraduccionesService.Traducciones["Exito"],
                        DiccionarioTraduccionesService.Traducciones["GuardarFechaN"]
                    ));
            }
            else
            {
                NotificationService.Notify(
                    Notificar.Notificacion(
                        "advertencia",
                        DiccionarioTraduccionesService.Traducciones["Atencion"],
                        DiccionarioTraduccionesService.Traducciones["ErrorInesp"]
                    ));
            }

            await Reset();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                Notificar.Notificacion(
                    "error",
                    DiccionarioTraduccionesService.Traducciones["EDato"],
                    ex.Message
                ));
        }
    }

    protected async Task Reset()
    {
        fechaProg = new FechaProgDTO
        {
            Fpprogra = DateTime.Today
        };

        idCent = 0;
        idDiv = 0;
        idLin = 0;
    }

    private static string GetFpEstadoString(FechaProgDTO d)
    => d.Fpestado ? "true" : "false";

    private static void SetFpEstadoString(FechaProgDTO d, string v)
    {
        d.Fpestado = string.Equals(v, "true", StringComparison.OrdinalIgnoreCase);
    }

    protected async Task Get()
    {
        if (idCent != 0 && idDiv != 0 && idLin != 0)
        {
            MaestraData.fechaProg = new List<FechaProgDTO>();
            dataIsLoaded = 0;
            await MaestraData.GetMaestraXLinea(idLin);
            if (fecha1 > fecha2)
            {
                NotificationService.Notify(Notificar.Notificacion("advertencia", DiccionarioTraduccionesService.Traducciones["Atencion"], DiccionarioTraduccionesService.Traducciones["SegundaFechaN"]));
            }
            else if (fecha1 != null && fecha2 != null)
            {
                _fecha1 = (DateTime)fecha1;
                _fecha2 = (DateTime)fecha2;
                int idBusqueda = MaestraData.maestra.Where(m => m.IdLinea == idLin).FirstOrDefault().IdMaster;
                dataIsLoaded = 1;
                MaestraData.fechaProg = await MaestraData.GetFechaTrabajoXFecha(_fecha1, _fecha2, idBusqueda);
                foreach (var item in MaestraData.fechaProg)
                {
                    item.linea = MaestraData.maestra.Where(m => m.IdLinea == idLin).FirstOrDefault().Linea;
                }
                dataIsLoaded = 2;
            }
            else if (fecha1 != null && fecha2 == null || fecha1 == null && fecha2 != null)
            {
                NotificationService.Notify(Notificar.Notificacion("advertencia", DiccionarioTraduccionesService.Traducciones["Atencion"], DiccionarioTraduccionesService.Traducciones["ColocarFecha"]));
            }
            else
            {
                int idBusqueda = MaestraData.maestra
                    .Where(m => m.IdLinea == idLin)
                    .FirstOrDefault().IdMaster;
                dataIsLoaded = 1;
                MaestraData.fechaProg =
                    await MaestraData.GetFechaTrabajoXIdMaster(idBusqueda, true);
                foreach (var item in MaestraData.fechaProg)
                {
                    item.linea = MaestraData.maestra
                        .Where(m => m.IdLinea == idLin)
                        .FirstOrDefault().Linea;
                }
                dataIsLoaded = 2;
            }
        }
        else
        {
            NotificationService.Notify(Notificar.Notificacion("advertencia", DiccionarioTraduccionesService.Traducciones["Atencion"], DiccionarioTraduccionesService.Traducciones["CamposNecesarios"]));
        }
        tipo = 2;
    }

    async Task Habilitar(int id)
    {
        idFechaPro = id;

        if (!_snapshotsFechas.ContainsKey(id))
        {
            var current = MaestraData.fechaProg.FirstOrDefault(x => x.IdFechaPr == id);
            if (current != null)
            {
                _snapshotsFechas[id] = CloneFecha(current);
            }
        }
    }
    
    async Task Cancelar()
    {
        if (idFechaPro != 0 &&
            _snapshotsFechas.TryGetValue(idFechaPro, out var snap))
        {
            var current = MaestraData.fechaProg
                .FirstOrDefault(x => x.IdFechaPr == idFechaPro);

            if (current != null)
                CopyFecha(snap, current);

            _snapshotsFechas.Remove(idFechaPro);
        }

        idFechaPro = 0;
        StateHasChanged();
    }
