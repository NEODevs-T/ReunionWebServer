                    </BSInput>
                    <BSFeedback For="@(() =>idDiv)" ValidMessage="Correcto." />
                </BSCol>


                <BSCol Column="3">
                    <BSLabel>Línea</BSLabel>
                    <BSInput InputType="InputType.Select" @bind-Value="idLin">
                        <option value="0">Seleccione...</option>
                        @foreach (var d in MaestraData.lineas)
                        {
                            <option value="@d.IdLinea">@d.Linea</option>
                        }
                    </BSInput>
                    <BSFeedback For="@(() =>idLin)" ValidMessage="Correcto." />
                </BSCol Colum="3">
                <BSCol>


                    <BSRow>
                        <BSLabel>Buscar</BSLabel>
                    </BSRow>
                    <button onclick="@Get" class="btn btn-success"><i class="oi oi-magnifying-glass"></i></button>
                </BSCol>
            </BSRow>
            @* <p></p>
            <div class="box">
                <div class="box_flex">
                    <BSCol Column="2" class="box_date date--from">
                        <BSLabel>Desde</BSLabel>
                        <BSInput InputType="InputType.Date" @bind-Value="fecha1">
                        </BSInput>
                    </BSCol Colum="2">
                    <BSCol Column="2" class="box_date date--to">
                        <BSLabel>Hasta</BSLabel>
                        <BSInput InputType="InputType.Date" @bind-Value="fecha2">
                        </BSInput>
                    </BSCol Colum="2">
                </div>
            </div>
            <p></p> *@


            @if (MaestraData.fechaProg.Count() > 0 && dataIsLoaded == 2)
            {

                <p></p>
                <BSContainer>


                    <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
                        <BSTHead Class="cabecera">
                            <BSTR>

                                @* <BSTD>ID</BSTD> *@
                                <BSTD>Línea</BSTD>
                                <BSTD>Fecha Programada</BSTD>
                                <BSTD>Descripcion</BSTD>
                                <BSTD>Estado</BSTD>
                                @if (UsrRol == "Admin" || UsrRol == "SuperAdmin" || UsrRol == "Planificador")
                                {
                                    <BSTD>Editar</BSTD>
                                }



                            </BSTR>
                        </BSTHead>
                        <BSTBody>




                            @foreach (var d in MaestraData.fechaProg)
                            {
                                <BSTR>
                                    <BSTD>@d.linea</BSTD>
                                    @if (idFechaPro == d.IdFechaPr)
                                    {
                                        <BSTD>

                                            <BSInput InputType="InputType.Date" @bind-Value="d.Fpprogra" />
                                            <BSFeedback For="@(() => d.Fpprogra)" ValidMessage="Correcto." />

                                        </BSTD>

                                        <BSTD>

                                            <BSInput InputType="InputType.Text" @bind-Value="d.Fpdesc" />
                                            <BSFeedback For="@(() => d.Fpdesc)" ValidMessage="Correcto." />

                                        </BSTD>

                                        <BSTD>

                                            <BSInput InputType="InputType.Select" @bind-Value="d.Fpestado">
                                                <option value="true">Activar</option>
                                                <option value="false">Desactivar</option>
                                            </BSInput>
                                            <BSFeedback For="@(() => d.Fpestado)" ValidMessage="Correcto." />

                                        </BSTD>
                                        <BSTD>

                                            @* <BSButton Color="BSColor.Primary" IsOutlined @onclick="(() => Editar(d))" Target="History"><i
                                                    class="oi oi-circle-check"></i></BSButton>
                                            <BSButton Color="BSColor.Danger" IsOutlined @onclick="Cancelar" Target="History"><i
                                                    class="oi oi-circle-x"></i></BSButton> *@
                                            <BSButton Color="BSColor.Primary" IsOutlined @onclick="(() => Editar(d))" Target="History"><i
                                                    class="oi oi-circle-check"></i></BSButton>
                                            <BSButton Color="BSColor.Danger" IsOutlined @onclick="Cancelar" Target="History"><i
                                                    class="oi oi-circle-x"></i></BSButton>
                                        </BSTD>

                                    }
                                    else
                                    {
                                        <BSTD>
                                            @d.Fpprogra.ToString("dd/MM/yyyy")
                                        </BSTD>


                                        <BSTD>
                                            @d.Fpdesc
                                        </BSTD>

                                        <BSTD>
                                            @if (d.Fpestado == true)
                                            {
                                                <p>Activo</p>
                                            }
                                            else
                                            {
                                                <p>Inactivo</p>
                                            }
                                        </BSTD>
                                        @if (UsrRol == "Admin" || UsrRol == "SuperAdmin" || UsrRol == "Planificador")
                                        {
                                            <BSTD>
                                                <BSButton Color="BSColor.Success" IsOutlined @onclick="(() => Habilitar(d.IdFechaPr))"
                                                    Target="History"><i class="oi oi-pencil"></i></BSButton>
                                            </BSTD>
                                        }

                                    }
                                </BSTR>

                            }

                        </BSTBody>

                    </BSTable>
                </BSContainer>
            }
            else if (dataIsLoaded == 1 && MaestraData.fechaProg.Count() == 0)
            {
                <div class="loader"></div>
            }
            else if (dataIsLoaded == 2 && MaestraData.fechaProg.Count() == 0)
            {
                <div style="text-align: center; padding: 20px; font-size: 18px; color: rgb(102, 101, 101);">
                <p>No hay fecha Programada</p>
                </div>
            }




        }
        else
        {
            <AuthorizeView Roles="Admin,Planificador">
                <Authorized>
                    <BSInputRadio CheckedValue="@(1)" @bind-Value="tipo" IsToggle="true" Size="Size.ExtraSmall"
                        Color="BSColor.Success" IsOutlined="true">
                        Agregar Fecha Programada
                        <span class="oi oi-plus"></span>
                    </BSInputRadio>
                </Authorized>
            </AuthorizeView>
            <BSInputRadio @bind-Value="tipo" CheckedValue="@(2)" IsToggle="true" Size="Size.ExtraSmall" Color="BSColor.Success"
                IsOutlined="true">
                Consultar Fecha Programada
                <span class="oi oi-magnifying-glass"></span>
            </BSInputRadio>
        }
    </body>

    </html>
}



