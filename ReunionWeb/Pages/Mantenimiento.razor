    async Task Editar(FechaProgDTO fechaP)
    {
        try
        {
            bool band = await MaestraData.UpdateFechaTrabajo(fechaP, fechaP.IdFechaPr);

            if (band)
            {
                NotificationService.Notify(
                    Notificar.Notificacion("exito",
                    DiccionarioTraduccionesService.Traducciones["Exito"],
                    DiccionarioTraduccionesService.Traducciones["MExito"]));
            }

            _snapshotsFechas.Remove(fechaP.IdFechaPr);
            idFechaPro = 0;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                Notificar.Notificacion("error",
                DiccionarioTraduccionesService.Traducciones["EDato"],
                ex.Message));
        }
    }

