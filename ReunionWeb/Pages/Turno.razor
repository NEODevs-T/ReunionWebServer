@page "/es/turno"
@page "/en/shift"

@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject IMaestraData MaestraData
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject NotificationService NotificationService
@inject IDiccionarioTraduccionesService DiccionarioTraduccionesService
@inject LocalizationService LocalizationService
@inject ITranslationService Translator

@using ReunionWeb.Resources
@using System.Globalization
@using ReunionWeb.Services

@attribute [Authorize(Roles = "Admin, AdminChempro, PrimeUser, SuperUser, SemiAdmin,SuperAdmin")]

@if (!traduccionesCargadas || MaestraData.centro.Count() == 0)
{
     <div class="loader"></div>
}
else
{
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@DiccionarioTraduccionesService.Traducciones["Consolidacion"]</title>
</head>

<body>
    <h3>@DiccionarioTraduccionesService.Traducciones["ConsolidacionDeDiscrepancia"]</h3>
    @* ccc *@
    <div class="box-reuform">
        <div class="box-reuCent">
            <label for="">@DiccionarioTraduccionesService.Traducciones["Centro"]
                <BSInput InputType="InputType.Select" class="Form-imput" @onchange="BuscarDivision"
                    @bind-Value="idCent">
                    <option value="0">@DiccionarioTraduccionesService.Traducciones["SeleccioneUnCentro"]</option>
                    @if (MaestraData.centro != null)
                    {
                        @foreach (var d in MaestraData.centro)
                        {
                            <option value="@d.IdCentro">@d.Centro</option>

                        }
                    }
                </BSInput>
            </label>
        </div>
        <div class="box-reuDiv">
            <label for="">@DiccionarioTraduccionesService.Traducciones["Division"]
                <BSInput InputType="InputType.Select" class="Form-imput linea" @bind-Value="idDiv">
                    <option value="0">@DiccionarioTraduccionesService.Traducciones["SeleccioneUnaDivision"]</option>
                    @if (MaestraData.centro != null)
                    {
                        @foreach (var d in MaestraData.divisions)
                        {
                            <option value="@d.IdDivision">@d.Ndivision</option>

                        }
                    }
                </BSInput>
            </label>
        </div>
        <div class="box-reutipo">
            <label for="">@DiccionarioTraduccionesService.Traducciones["Buscar"]
                <BSInput InputType="InputType.Select" class="Form-imput linea" @bind-Value="tipo">
                    <option value="0">@DiccionarioTraduccionesService.Traducciones["SeleccioneBuscar"]</option>
                    @if (MaestraData.centro != null)
                    {
                        <option value="1">@DiccionarioTraduccionesService.Traducciones["VencidasTurno"]</option>
                        <option value="2">@DiccionarioTraduccionesService.Traducciones["PendientesLibro"]</option>
                        <option value="3">@DiccionarioTraduccionesService.Traducciones["KsfReunionDiaria"]</option>

                    }
                </BSInput>
            </label>
        </div>

        <div class="botton-Disc">
            <button @onclick="buscar" type="submit" id="btn-disc" class="btn btn-primary mb-3">@DiccionarioTraduccionesService.Traducciones["Buscar"]</button>
        </div>
    </div>
    @if (band == true)
    {

        @if (PizarraData.reudiatablas.Count() == 0 && confirmacion == false)
        {
            <div class="loader"></div>
        }
        else if (PizarraData.reudiatablas.Count() > 0 && confirmacion == true)
        {
            <RadzenDataGrid @ref="reunion" AllowFiltering="true" FilterPopupRenderMode="PopupRenderMode.OnDemand"
                class="tabla-radzen" AllowPaging="true" PageSize="10" AllowSorting="true" Data="@PizarraData.reudiatablas"
                TItem="ReunionDTO">
                <Columns>
                    <RadzenDataGridColumn Width="5%" TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["Linea"]" Filterable="false" Sortable="false"
                        TextAlign="TextAlign.Center">
                        <Template Context="data">
                            <RadzenText class="mb-0 tipografia">@data.Rdarea</RadzenText>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5%" TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]" Filterable="false" Sortable="false"
                        TextAlign="TextAlign.Center">
                        <Template Context="data">
                            <RadzenText class="mb-0 tipografia">@data.RdcodEq</RadzenText>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="10%" TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["NombreDelEquipo"]" Filterable="false" Sortable="false"
                        TextAlign="TextAlign.Center">
                        <Template Context="data">
                            <RadzenText class="mb-0 tipografia">@(string.IsNullOrWhiteSpace(data.EnombreEam) ? (idPais == 5 ? "EQUIPMENT NOT FOUND" : "EQUIPO NO ENCONTRADO")
                                        : data.EnombreEam)
                            </RadzenText>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5%" TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["Discrepancia"]" Filterable="false" Sortable="false"
                        TextAlign="TextAlign.Center">
                        <Template Context="data">
                            <RadzenText class="mb-0 tipografia">@data.Rddisc</RadzenText>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5%" TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["PlanDeAccion"]" Filterable="false"
                        Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            <RadzenText class="mb-0 tipografia">@data.RdplanAcc</RadzenText>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5%" TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["FReunion"]" Filterable="false" Sortable="false"
                        TextAlign="TextAlign.Center">
                        <Template Context="data">
                            <RadzenText class="mb-0 tipografia">@data.RdfecReu.ToString("dd/MM/yyyy")</RadzenText>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5%" TItem="ReunionDTO" Title="@DiccionarioTraduccionesService.Traducciones["Acciones"]" Filterable="false" Sortable="false"
                        TextAlign="TextAlign.Center">
                        <Template Context="data">
                            @if (libro == 0)
                            {
                                <RadzenButton Icon="add" Size="ButtonSize.Small" Click="@(() => Add(data))" />
                            }
                            <RadzenButton Icon="delete" Size="ButtonSize.Small" Click="@(() => Rechazada(data))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else if (PizarraData.reudiatablas.Count() == 0 && confirmacion == true)
        {
<div style="text-align: center; padding: 20px; font-size: 18px; color: gray;">
    <p>@DiccionarioTraduccionesService.Traducciones["NoHayRegistros"]</p>
</div>
        }

    }
</body>
<style>
    .box-reuform {
        padding-top: 10px;
        display: flex;
        justify-content: flex-start;
        /* O flex-start para alinear a la izquierda */
        align-items: center;
        /* height: 100vh; */
    }


    .box-reuCent {
        margin: 10px;
    }

    .tabla-radzen {
        border-radius: 10px;
        box-shadow: 0px 0px 5px #0003;

    }

    .box-reuDiv {
        margin: 10px;
        @* position: relative; *@
        /* o absolute, dependiendo de tus necesidades */
        bottom: 10px;
        /* Ajusta según sea necesario */
        left: 20px;
        /* Ajusta según sea necesario */
    }

    .box-reutipo {
        margin: 10px;
    }

    .botton-Disc {
        padding: 20px;
        padding-top: 40px;
    }

    #btn-disc {
        background-color: #00aa7b;
        border: none;
        color: white;
        padding: 10px 20px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 16px;
        margin: 4px 2px;
        cursor: pointer;
        box-shadow: 0px 0px 5px #0003;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }

    #btn-disc:hover {
        background-color: #00b356;
    }

    .Form-imput {
        width: 100%;
        box-sizing: border-box;
        padding: 6px 8px;
        border: none #777;
        box-shadow: 0px 0px 5px #0003;
        border: 1px solid #777;
        /* border-left: 2px solid #666; */
        /* border-radius: 5px; */
        background-color: transparent;
        color: #000;
        margin: 3px;
        border-radius: 5px;
    }

    .linea {
        width: 165px;
    }
</style>

</html>
}
@code {
    int idCent = 0;
    int idDiv = 0;
    string estado { get; set; }
    bool band = false;
    public DateTime fecha1;
    public DateTime fecha2;
    private List<Claim> claims { get; set; }
    private string mensaje = "";
    public RadzenDataGrid<ReunionDTO> reunion { get; set; } = new RadzenDataGrid<ReunionDTO>();
    private NotifiRadzen Notificar = new NotifiRadzen();
    bool confirmacion;
    int tipo = 1;
    int libro = 0;
    private int idPais {get; set;}
    private bool traduccionesCargadas = false;

    private async Task CreateData()

    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        fecha1 = DateTime.Now;
        fecha2 = DateTime.Now;
        await CreateData();
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;

        PizarraData.reudiatablas = new List<ReunionDTO>();
        if (claims != null && claims.Count > 1 && (claims[1]?.Value == "Admin" || claims[1]?.Value == "SuperAdmin" || claims[1]?.Value == "PrimeUser"))
        {

            await MaestraData.GetCentrosxEmpresa("All" + claims[10].Value);
        }
        else
        {
            await MaestraData.GetCentrosxEmpresa(claims[11].Value);
        }
    }
    protected async Task BuscarDivision(ChangeEventArgs e)
    {
        idCent = int.Parse(e.Value.ToString());
        idDiv = 0;
        try
        {
            if (idCent != 0)
            {
                MaestraData.divisions = await MaestraData.ObtenerDivisionDelCentro(idCent);
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error: " + ex.Message;
        }
    }

    protected async Task buscar()
    {
        if (idCent != 0 && idDiv != 0)
        {
            if (tipo == 1)
            {
                band = true;
                PizarraData.reudiatablas = new List<ReunionDTO>();
                confirmacion = false;
                string idCentro = idCent.ToString();
                string IdDivision = idDiv.ToString();
                PizarraData.reudiatablas = await PizarraData.GetPendientesTurno(idCentro, IdDivision);
                PizarraData.reudiatablas.Select(x => x.RdfecReu.ToString("dd/MM/yyyy")).ToList();
                confirmacion = true;
                libro = 0;
            }
            else if (tipo == 2)
            {
                band = true;
                PizarraData.reudiatablas = new List<ReunionDTO>();
                confirmacion = false;
                string idCentro = idCent.ToString();
                string IdDivision = idDiv.ToString();
                PizarraData.reudiatablas = await PizarraData.GetPendienteslibros(idCentro, IdDivision);
                PizarraData.reudiatablas.Select(x => x.RdfecReu.ToString("dd/MM/yyyy")).ToList();
                confirmacion = true;
                libro = 0;
            }
            else if (tipo == 3)
            {
                band = true;
                PizarraData.reudiatablas = new List<ReunionDTO>();
                confirmacion = false;
                string idCentro = idCent.ToString();
                string IdDivision = idDiv.ToString();
                PizarraData.reudiatablas = await PizarraData.GetPendientesdeTurnoADiaria(idCentro, IdDivision);
                PizarraData.reudiatablas.Select(x => x.RdfecReu.ToString("dd/MM/yyyy")).ToList();
                confirmacion = true;
                libro = 0;
            }
        }
        else
        {
            mensaje = DiccionarioTraduccionesService.Traducciones["VerifiqueCampos"];
            NotificationService.Notify(Notificar.Notificacion("advertencia", mensaje, ""));

        }
    }

    


    protected async Task Add(ReunionDTO e)
{
    ReunionDTO registro = e;
    registro.IdTipReu = 1;
    registro.RdfecReu = DateTime.Now.Date;

    if (tipo == 2)
    {
        registro.Rdstatus = "Pendiente";
    }

    bool validacion = await PizarraData.UpdateDiscrepancia3(registro, registro.IdReuDia);

    if (validacion == true)
    {
        mensaje =  DiccionarioTraduccionesService.Traducciones["ReunionDiariaAgregada"];
        NotificationService.Notify(Notificar.Notificacion("exito", mensaje, ""));
        await buscar();
    }
    else
    {
        mensaje = DiccionarioTraduccionesService.Traducciones["NoAgregada"];
        NotificationService.Notify(Notificar.Notificacion("advertencia", mensaje, ""));
    }
}

    
    protected async Task Rechazada(ReunionDTO e)
    {
        ReunionDTO registro = e;
        registro.IdTipReu = 1;
        registro.Rdstatus = "Rechazada";
        bool validacion = await PizarraData.UpdateDiscrepancia3(registro, registro.IdReuDia);
        if (validacion == true)
        {
            mensaje = DiccionarioTraduccionesService.Traducciones["DiscrepanciaRechazada"];
            NotificationService.Notify(Notificar.Notificacion("exito", mensaje, ""));
            await buscar();

        }
        else
        {
            mensaje = DiccionarioTraduccionesService.Traducciones["NoRechazada"];
            NotificationService.Notify(Notificar.Notificacion("advertencia", mensaje, ""));
        }
    }

}