@*Tabla vieja*@
@if (PizarraData.reudiatablas.Count() > 0 &&  dataIsLoaded == 2)
{
    <div class=" pt-3">

        <BSTable IsStriped="true" IsResponsive=true IsBordered="true" IsHoverable="true">
            <BSTHead Class="cabecera">
                <BSTR>
                    @*<BSTD>Id</BSTD>*@
                    <BSTD>@ValidationMessages.Area</BSTD>
                    <BSTD>Ksf</BSTD>
                    <BSTD>@ValidationMessages.CodigoDeEquipo</BSTD>
                    <BSTD>@ValidationMessages.NombreDelEquipo</BSTD>
                    <BSTD Class="col-5">@ValidationMessages.Discrepancia</BSTD>
                    <BSTD>@ValidationMessages.Codigo</BSTD>
                    <BSTD Class="col-4">@ValidationMessages.PlanDeAccion</BSTD>
                    <BSTD>@ValidationMessages.Tiempo</BSTD>
                    <BSTD>@ValidationMessages.Responsable</BSTD>
                    <BSTD>@ValidationMessages.Estado</BSTD>
                    <BSTD>@ValidationMessages.Requisicion</BSTD>
                    <BSTD>ODT</BSTD>
                    <BSTD>@ValidationMessages.FechaDeReunion</BSTD> @*Fecha del dia de reunion*@
                    <BSTD>@ValidationMessages.FechaDelTrabajo</BSTD>@*Fecha de listo el trabajo*@
                    <BSTD></BSTD>
                </BSTR>
            </BSTHead>
            <BSTBody>


                @foreach (var d in listareu)
                {
                    @if(d.Rdstatus != "Rechazada")
                    {
                        @if (Codigo == d.RdcodDis | Codigo == "Todo")
                        {

                            @if (NombreLinea == "Todo" | NombreLinea == d.Rdarea)
                            {
                                @if (idrespo == 0 | idrespo == d.IdResReu)
                                {

                                    @if (IdKsf == 0 | IdKsf == d.Idksf)
                                    {

                                        <BSTR Class="@GetClassVencido(d.RdfecTra, d.Rdstatus)">

                                            @*<BSTD>@d.IdReuDia</BSTD>*@
                                            <BSTD>@d.Rdarea</BSTD>
                                                <BSTD>                                
                                                    @{
                                                        var texto = idPais == 5 
                                                        ? KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfEnglish 
                                                        : KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfNombre;
                                                    }
                                                    @texto
                                                </BSTD>
                                                <BSTD>@d.RdcodEq</BSTD>
                                                <BSTD>
                                                    @{
                                                        var texto = string.IsNullOrWhiteSpace(d.EnombreEam)
                                                        ? (idPais == 5 ? "EQUIPMENT NOT FOUND" : "EQUIPO NO ENCONTRADO")
                                                        : d.EnombreEam;
                                                    }
                                                    @texto
                                                </BSTD>
                                                <BSTD>@d.Rddisc.ToUpperInvariant()</BSTD>
                                                <BSTD>@d.RdcodDis</BSTD>
                                                <BSTD Class="textotabla">@d.RdplanAcc</BSTD>
                                                <BSTD>@d.Rdtiempo</BSTD>
                                                @{
                                                    var nombreResponsable = RespoReuData.resporeus.FirstOrDefault(x => x.IdResReu == d.IdResReu)?.Rrnombre;
                                                    var textoTraducido = ValidationMessages.ResourceManager.GetString(
                                                    ValidationMessages.MapResponsableKey(nombreResponsable),
                                                    CultureInfo.CurrentUICulture
                                                );
                                                }
                                                <BSTD class="@(nombreResponsable == "Por Definir" ? "Definir" : "")">
                                                    @textoTraducido
                                                </BSTD>
                                                @{
                                                    var estadoTraducido = d.Rdstatus switch
                                                    {
                                                        "Listo" => idPais == 5 ? "Ready" : "Listo",
                                                        "Cerrado" => idPais == 5 ? "Closed" : "Cerrado",
                                                        _ => idPais == 5 ? "Pending" : "Pendiente"
                                                    };

                                                    var claseEstado = d.Rdstatus switch
                                                    {
                                                        "Listo" => "listo",
                                                        "Cerrado" => "Cerrado",
                                                        _ => "pendiente"
                                                    };

                                                    var codRequiTexto = d.RdcodRequi == null ? "N/A" : d.RdcodRequi;
                                                }
                                                <BSTD Class="@claseEstado">@estadoTraducido</BSTD>
                                                <BSTD>@codRequiTexto</BSTD>
                                            <BSTD>@d.Rdodt</BSTD>
                                                <BSTD>@d.RdfecReu.ToString("dd/MM/yyyy")</BSTD>
                                                <BSTD>@d.RdfecTra.ToString("dd/MM/yyyy")</BSTD>
                                                <BSTD>
                                                    <BSRow>
                                                        <BSCol>
                                                        @if(isEditar){
                                                            <button class="btn btn-success" @onclick="(() => Editar(d.IdReuDia))"><i class="oi oi-pencil"></i></button>
                                                        }
                                                        </BSCol>
                                                        <BSCol>
                                                            @if (UsrAdmin != "")
                                                        {
                                                            <BSButton Color="BSColor.Primary" IsOutlined @onclick="(() => GetHistory(d.IdReuDia))" Target="History"><i class="oi oi-eye"></i></BSButton>
                                                        }
                                                    </BSCol>
                                                </BSRow>
                                            </BSTD>
                                        </BSTR>
                                    }
                                }
                            }
                        }
                    }
                }
            </BSTBody>
        </BSTable>
    </div>

    @*Mostrar la trazabilidad*@
    <BSModal IsCentered="true" DataId="History">
        <Header>@ValidationMessages.Trazabilidad</Header>
        <Content>
            <h5>@ValidationMessages.CambiosDeEstados:</h5>
            @if (cambiostatuss.Count() > 0 && cargandocambio == true)
            {
                <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
                    <BSTHead Class="cabecera">
                        <BSTR>
                            <BSTD>@ValidationMessages.FechaDelCambio</BSTD>
                            <BSTD>@ValidationMessages.StatusNuevo</BSTD>
                            <BSTD>@ValidationMessages.Usuario</BSTD>
                        </BSTR>
                    </BSTHead>
                    <BSTBody>
                    @foreach (var d in cambiostatuss)
                    {
                        <BSTR>
                            <BSTD>@d.Cbfecha</BSTD>
                            <BSTD>@ValidationMessages.ResourceManager.GetString(
                                ValidationMessages.MapStatusKey(d.Cbstat),
                                CultureInfo.CurrentUICulture
                            )</BSTD>
                            <BSTD>@d.Cbuser</BSTD>
                        </BSTR>
                    }
                    </BSTBody>
                </BSTable>
            }
            else if (cambiostatuss.Count() == 0 && cargandocambio == false)
            {
                <BSSpinner SpinnerType="SpinnerType.Grow" Color="BSColor.Success" />
            }
            else if (cambiostatuss.Count() == 0 && cargandocambio == true)
            {
                <p>@ValidationMessages.NoHayRegistros2</p>
            }
            <p></p>
            <p></p>
            <h5>@ValidationMessages.CambiosDeFechaTrabajo</h5>

            @if (cambiofechas.Count() > 0)
            {
                <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
                    <BSTHead Class="cabecera">
                        <BSTR>
                            <BSTD>@ValidationMessages.FechaDelCambio</BSTD>
                            <BSTD>@ValidationMessages.NuevaFechaDeTrabajo</BSTD>
                            <BSTD>@ValidationMessages.Usuario</BSTD>
                        </BSTR>
                    </BSTHead>
                    <BSTBody>
                        @foreach (var d in cambiofechas)
                        {
                            <BSTR>
                                <BSTD>@d.Cffec</BSTD>
                                    <BSTD>@d.CffecNew</BSTD>
                                    <BSTD>@d.Cfuser</BSTD>
                                </BSTR>
                        }
                    </BSTBody>
                </BSTable>
            }
            else if (cambiofechas.Count() == 0 && cargandocambio == false)
            {
                <BSSpinner SpinnerType="SpinnerType.Grow" Color="BSColor.Success" />
            }
            else if (cambiofechas.Count() == 0 && cargandocambio == true)
            {
                <p>@ValidationMessages.NoHayRegistros2</p>
            }
        </Content>
        <Footer Context="modal">
            <BSButton MarginStart="Margins.Auto" Color="BSColor.Success" @onclick="modal.HideAsync">@ValidationMessages.Aceptar</BSButton>

        </Footer>
    </BSModal>


}
else if (dataIsLoaded == 1 && PizarraData.reudiatablas.Count() == 0)
{
    <div class="loader"></div>
}
else if (dataIsLoaded == 2 && PizarraData.reudiatablas.Count() == 0)
{
<div style="text-align: center; padding: 20px; font-size: 18px; color: rgb(102, 101, 101);">
    <p>@ValidationMessages.NoHayDatos2</p>
</div>
}

