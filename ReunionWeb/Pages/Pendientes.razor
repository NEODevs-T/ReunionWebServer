@*Tabla vieja*@
@if (PizarraData.reudiatablas.Count() > 0 &&  dataIsLoaded == 2)
{



<div class="tabla-contenedor">
    <div class="tabla-scroll">
        <div class=" pt-3">
                <table>

        <BSTable IsStriped="true" IsResponsive=true IsBordered="true" IsHoverable="true">
            <BSTHead Class="cabecera">
                <BSTR>
                    @*<BSTD>Id</BSTD>*@
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Area"]</BSTD>
                    <BSTD>Ksf</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["NombreDelEquipo"]</BSTD>
                    <BSTD Class="col-5">@DiccionarioTraduccionesService.Traducciones["Discrepancia"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Codigo"]</BSTD>
                    <BSTD Class="col-4">@DiccionarioTraduccionesService.Traducciones["PlanDeAccion"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Tiempo"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Responsable"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Estado"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Requisicion"]</BSTD>
                    <BSTD>ODT</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDeReunion"]</BSTD> @*Fecha del dia de reunion*@
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDeTrabajo"]</BSTD>@*Fecha de listo el trabajo*@
                    <BSTD></BSTD>
                </BSTR>
            </BSTHead>
            <BSTBody>


                @foreach (var d in listareu)
                {
                    @if(d.Rdstatus != "Rechazada")
                    {
                        @if (Codigo == d.RdcodDis | Codigo == "Todo")
                        {

                            @if (IdMasterSeleccionado == 0 | IdMasterSeleccionado == d.IdMaster)
                            {
                                @if (idrespo == 0 | idrespo == d.IdResReu)
                                {

                                    @if (IdKsf == 0 | IdKsf == d.Idksf)
                                    {

                                        <BSTR Class="@GetClassVencido(d.RdfecTra, d.Rdstatus)">

                                            @*<BSTD>@d.IdReuDia</BSTD>*@
                                            <BSTD>@d.Rdarea</BSTD>
                                                <BSTD>                                
                                                    @{
                                                        var texto = idPais == 5 
                                                        ? KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfEnglish 
                                                        : KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfNombre;
                                                    }
                                                    @texto
                                                </BSTD>
                                                <BSTD>@d.RdcodEq</BSTD>
                                                <BSTD>
                                                    @{
                                                        var texto = string.IsNullOrWhiteSpace(d.EnombreEam)
                                                        ? (idPais == 5 ? "EQUIPMENT NOT FOUND" : "EQUIPO NO ENCONTRADO")
                                                        : d.EnombreEam;
                                                    }
                                                    @texto
                                                </BSTD>
                                                <BSTD>@d.Rddisc.ToUpperInvariant()</BSTD>
                                                <BSTD>@d.RdcodDis</BSTD>
                                                <BSTD Class="textotabla">@d.RdplanAcc</BSTD>
                                                <BSTD>@d.Rdtiempo</BSTD>
                                                @{
                                                    var responsable = RespoReuData.resporeus.FirstOrDefault(x => x.IdResReu == d.IdResReu);
                                                    var nombreResponsable = idPais == 5 
                                                    ? responsable?.Rrenglish 
                                                    : responsable?.Rrnombre ?? string.Empty;
                                                }
                                                <BSTD class="@(nombreResponsable == "Por Definir" ? "Definir" : "")">@nombreResponsable</BSTD>
                                                @{
                                                    var esVencido = d.RdfecTra.Date < DateTime.Now.Date
                                                                    && (d.Rdstatus?.StartsWith("Pendiente", StringComparison.OrdinalIgnoreCase) ?? false);

                                                    var claveMostrada = esVencido ? "Vencidos" : ValidationMessages.MapStatusKey(d.Rdstatus);

                                                    var estadoTraducido = DiccionarioTraduccionesService.Traducciones.ContainsKey(claveMostrada)
                                                        ? DiccionarioTraduccionesService.Traducciones[claveMostrada]
                                                        : claveMostrada;

                                                    var claseEstado = esVencido
                                                        ? "Vencido"
                                                        : d.Rdstatus switch
                                                        {
                                                            "Listo"   => "listo",
                                                            "Cerrado" => "Cerrado",
                                                            _         => "pendiente"
                                                        };
                                                }
                                                <BSTD Class="@claseEstado">@estadoTraducido</BSTD>

                                                @{
                                                    var codRequiTexto = d.RdcodRequi == null ? "N/A" : d.RdcodRequi;
                                                }
                                                <BSTD>@codRequiTexto</BSTD>
                                            <BSTD>@d.Rdodt</BSTD>
                                                <BSTD>@d.RdfecReu.ToString("dd/MM/yyyy")</BSTD>
                                                <BSTD>@d.RdfecTra.ToString("dd/MM/yyyy")</BSTD>
                                                <BSTD>
                                                    <BSRow>
                                                        <BSCol>
                                                        @if(isEditar){
                                                            <button class="btn btn-success" @onclick="(() => Editar(d.IdReuDia))"><i class="oi oi-pencil"></i></button>
                                                        }
                                                        </BSCol>
                                                        <BSCol>
                                                            @if (UsrAdmin == "Admin")
                                                        {
                                                            <BSButton Color="BSColor.Primary" IsOutlined @onclick="(() => GetHistory(d.IdReuDia))" Target="History"><i class="oi oi-eye"></i></BSButton>
                                                        }
                                                    </BSCol>
                                                </BSRow>
                                            </BSTD>
                                        </BSTR>
                                    }
                                }
                            }
                        }
                    }
                }
            </BSTBody>
        </BSTable>
            </table>
    </div>
    </div>
</div>


    @*Mostrar la trazabilidad*@
    <BSModal IsCentered="true" DataId="History">
        <Header>@DiccionarioTraduccionesService.Traducciones["Trazabilidad"]</Header>
        <Content>
            <h5>@DiccionarioTraduccionesService.Traducciones["CambiosDeEstados"]:</h5>
            @if (cambiostatuss.Count() > 0 && cargandocambio == true)
            {
                <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
                    <BSTHead Class="cabecera">
                        <BSTR>
                            <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDelCambio"]</BSTD>
                            <BSTD>@DiccionarioTraduccionesService.Traducciones["StatusNuevo"]</BSTD>
                            <BSTD>@DiccionarioTraduccionesService.Traducciones["Usuario"]</BSTD>
                        </BSTR>
                    </BSTHead>
                    <BSTBody>
                    @foreach (var d in cambiostatuss)
                    {
                        <BSTR>
                            <BSTD>@d.Cbfecha</BSTD>
                            <BSTD>@DiccionarioTraduccionesService.Traducciones[ValidationMessages.MapStatusKey(d.Cbstat)]
                            </BSTD>
                            <BSTD>@d.Cbuser</BSTD>
                        </BSTR>
                    }
                    </BSTBody>
                </BSTable>
            }
            else if (cambiostatuss.Count() == 0 && cargandocambio == false)
            {
                <BSSpinner SpinnerType="SpinnerType.Grow" Color="BSColor.Success" />
            }
            else if (cambiostatuss.Count() == 0 && cargandocambio == true)
            {
                <p>@DiccionarioTraduccionesService.Traducciones["NoHayRegistros2"]</p>
            }
            <p></p>
            <p></p>
            <h5>@DiccionarioTraduccionesService.Traducciones["CambiosDeFechaTrabajo"]</h5>

            @if (cambiofechas.Count() > 0)
            {
                <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
                    <BSTHead Class="cabecera">
                        <BSTR>
                            <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDelCambio"]</BSTD>
                            <BSTD>@DiccionarioTraduccionesService.Traducciones["NuevaFechaDeTrabajo"]</BSTD>
                            <BSTD>@DiccionarioTraduccionesService.Traducciones["Usuario"]</BSTD>
                        </BSTR>
                    </BSTHead>
                    <BSTBody>
                        @foreach (var d in cambiofechas)
                        {
                            <BSTR>
                                <BSTD>@d.Cffec</BSTD>
                                    <BSTD>@d.CffecNew</BSTD>
                                    <BSTD>@d.Cfuser</BSTD>
                                </BSTR>
                        }
                    </BSTBody>
                </BSTable>
            }
            else if (cambiofechas.Count() == 0 && cargandocambio == false)
            {
                <BSSpinner SpinnerType="SpinnerType.Grow" Color="BSColor.Success" />
            }
            else if (cambiofechas.Count() == 0 && cargandocambio == true)
            {
                <p>@DiccionarioTraduccionesService.Traducciones["NoHayRegistros2"]</p>
            }
        </Content>
        <Footer Context="modal">
            <BSButton MarginStart="Margins.Auto" Color="BSColor.Success" @onclick="modal.HideAsync">@DiccionarioTraduccionesService.Traducciones["Aceptar"]</BSButton>

        </Footer>
    </BSModal>


}
else if (dataIsLoaded == 1 && PizarraData.reudiatablas.Count() == 0)
{
    <div class="loader"></div>
}
else if (dataIsLoaded == 2 && PizarraData.reudiatablas.Count() == 0)
{
<div style="text-align: center; padding: 20px; font-size: 18px; color: rgb(102, 101, 101);">
    <p>@DiccionarioTraduccionesService.Traducciones["NoHayDatos2"]</p>
</div>
}

