    void Editar(int id)
    {
        var lineaEncoded = Uri.EscapeDataString(NombreLinea ?? "");
        var f1 = fecha1.ToString("dd-MM-yyyy");
        var f2 = fecha2.ToString("dd-MM-yyy");
        var estEncoded = Uri.EscapeDataString(NombreLinea ?? "");
        var ruta = idPais == 5 ? "en" : "es";
