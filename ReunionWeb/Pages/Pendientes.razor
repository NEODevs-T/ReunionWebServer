private bool EsOpcionTotalPendiente(string? s)
{
    var valor = (s ?? string.Empty).Trim();

    var tieneDic = DiccionarioTraduccionesService.Traducciones != null
                    && DiccionarioTraduccionesService.Traducciones.ContainsKey("TotalPendiente");

    var traducidoTP = tieneDic
        ? DiccionarioTraduccionesService.Traducciones["TotalPendiente"]
        : "Total Pendiente";

    return valor.Equals("Total Pendiente", StringComparison.OrdinalIgnoreCase)
        || valor.Equals("Total Pending", StringComparison.OrdinalIgnoreCase)
        || valor.Equals(traducidoTP, StringComparison.OrdinalIgnoreCase);
}

    private bool EsOpcionVencidos(string? s)
    {
        var valor = (s ?? string.Empty).Trim();

        var traducidoVencidos = DiccionarioTraduccionesService.Traducciones.ContainsKey("Vencidos")
            ? DiccionarioTraduccionesService.Traducciones["Vencidos"]
            : "Vencidos";

        // Contempla claves y traducciones (Español/English)
        return valor.Equals("Vencidos", StringComparison.OrdinalIgnoreCase)
            || valor.Equals("Expired", StringComparison.OrdinalIgnoreCase)
            || valor.Equals(traducidoVencidos, StringComparison.OrdinalIgnoreCase);
    }


    private void ConstruirCatalogoEquiposPorNombre()
    {
        EquiposOpciones = listareu
            .Select(r => new
            {
                Codigo = (r.RdcodEq ?? string.Empty).Trim(),
                Nombre = string.IsNullOrWhiteSpace(r.EnombreEam)
                    ? (idPais == 5 ? "EQUIPMENT NOT FOUND" : "EQUIPO NO ENCONTRADO")
                    : r.EnombreEam.Trim()
            })
            .Where(x => !string.IsNullOrWhiteSpace(x.Codigo)) // siempre necesitamos el código
            .GroupBy(x => x.Codigo, StringComparer.OrdinalIgnoreCase) // un código => una opción
            .Select(g =>
            {
                // si hay varias filas con el mismo código, toma el primer nombre no vacío
                var nombre = g.Select(x => x.Nombre)
                            .FirstOrDefault(n => !string.IsNullOrWhiteSpace(n))
                            ?? (idPais == 5 ? "EQUIPMENT NOT FOUND" : "EQUIPO NO ENCONTRADO");
                return new EquipoOpcion { Codigo = g.Key, Nombre = nombre };
                })
            .OrderBy(x => x.Nombre, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }


    private void AplicarFiltroPorCodigoSeleccionado()
