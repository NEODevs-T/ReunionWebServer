    bool EsVencido(DateTime fechaTrabajo, string? estadoOriginal)
    {
        var estado = estadoOriginal ?? string.Empty;
        return fechaTrabajo.Date < DateTime.Now.Date
                && estado.StartsWith("Pendiente", StringComparison.OrdinalIgnoreCase);
    }

    string GetVisualStatus(DateTime fechaTrabajo, string estadoOriginal)
    {
        if (EsVencido(fechaTrabajo, estadoOriginal))
        {
            // Si tienes traducción para "Vencido" en tu diccionario, úsala
            var clave = "Vencidos"; // o la clave exacta que uses en tu .resx
            return DiccionarioTraduccionesService.Traducciones.ContainsKey(clave)
                    ? DiccionarioTraduccionesService.Traducciones[clave]
                    : "Vencido";
        }

        // Tu lógica actual de traducción del estado original
        var claveEstado = ValidationMessages.MapStatusKey(estadoOriginal);
        return DiccionarioTraduccionesService.Traducciones.ContainsKey(claveEstado)
                ? DiccionarioTraduccionesService.Traducciones[claveEstado]
                : estadoOriginal;
    }

