        NavigationManager.NavigateTo(url);
        //NavigationManager.NavigateTo($"EditDisc/{id}/{tipoconsulta}/{NombreLinea}/{fecha1.ToString("dd-MM-yyyy")}/{fecha2.ToString("dd-MM-yyyy")}/{Status}/{Codigo}/{idrespo}/{IdKsf}");

