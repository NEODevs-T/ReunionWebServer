                var resp = RespoReuData.resporeus.FirstOrDefault(x => x.IdResReu == e.IdResReu);
                e.Responsable = resp?.Rrnombre ?? string.Empty;
            }

            listareu = PizarraData.reudiatablas.Where(r => !string.IsNullOrEmpty(r.Responsable) && r.Responsable.StartsWith(UsrRol)).ToList();

        }
        else
        {
            listareu = PizarraData.reudiatablas;

        }
    }

