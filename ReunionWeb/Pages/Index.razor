@code{
    private List<Claim> claims { get; set; }
    private string Pais { get; set; } = ""; //pais
    private string UsrRol { get; set; } = ""; //rol para filtrar
    private int idPais { get; set; }
    private const int TrinidadYTobago = 5;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState.User;

            if (user.Identity is not null && user.Identity.IsAuthenticated)
            {
                idPais = GetIdPais(user);

                // Redirigir si está en la raíz "/"
                var currentUri = Navigation.Uri;
                if (Navigation.ToBaseRelativePath(currentUri) == "")
                {
                    if (idPais == TrinidadYTobago)
                        Navigation.NavigateTo("/en/home", forceLoad: true);
                    else
                        Navigation.NavigateTo("/es/inicio", forceLoad: true);
                }
            }
        }
    }

    private int GetIdPais(ClaimsPrincipal user)
    {
        int.TryParse(user.FindFirst(c => c.Type == "IdPais")?.Value, out int _idPais);
        return _idPais;
    }
    }
