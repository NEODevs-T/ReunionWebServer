@layout EmptyLayout
@page "/es/TablaPendientes"
@page "/es/TablaPendientes/{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}/{idrespo:int}"
@page "/en/TablePending"
@page "/en/TablePending/{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}/{idrespo:int}"

@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject IMaestraData MaestraData

@using ReunionWeb.Resources
@using System.Globalization

<BSRow>
    <BSCol ColumnSmall="1" Column="2">
        <BSLabel>@ValidationMessages.Codigo</BSLabel>
        <BSInput InputType="InputType.Select" @bind-Value="Codigo">
            <option value="Todo">@ValidationMessages.Todo</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
        </BSInput>
    </BSCol>

    <BSCol ColumnSmall="1" Column="2">
        <BSLabel>@ValidationMessages.Estado</BSLabel>
        <BSInput InputType="InputType.Select" @bind-Value="Status">
            <option value="Total Pendiente">@ValidationMessages.TotalPendiente</option>
            <option value="Todo">@ValidationMessages.Todo</option>
            <option value="Pendiente">@ValidationMessages.Pendiente</option>
            <option value="Pendiente/Responsable">@ValidationMessages.Pendiente/ @ValidationMessages.Responsable</option>
            <option value="Listo">@ValidationMessages.Listo</option>
            <option value="Cerrado">@ValidationMessages.Cerrado</option>
            <option value="Vencidos">@ValidationMessages.Vencidos</option>
        </BSInput>
    </BSCol>

    <BSCol Column="3">
        <BSLabel>@ValidationMessages.Responsable</BSLabel>
        <BSInput InputType="InputType.Select" @bind-Value="idrespo">
            <option value=0>@ValidationMessages.Todo</option>
            @foreach (var d in RespoReuData.resporeus)
            {
                <option value="@d.IdResReu">@ValidationMessages.ResourceManager.GetString(ValidationMessages
                    .MapResponsableKey(d.Rrnombre),CultureInfo.CurrentUICulture)</option>
            }
        </BSInput>
    </BSCol>
        @{
            var lineaTraducida = ValidationMessages.ResourceManager.GetString(
                ValidationMessages.MapResponsableKey(linea),
                CultureInfo.CurrentUICulture
            );
        }
    <BSCol Column="3">
        <BSLabel>@ValidationMessages.Linea</BSLabel>
        <BSInput InputType="InputType.Text" @bind-Value="@lineaTraducida" IsReadonly=true />
    </BSCol>

</BSRow>
<button type="button" onclick="window.print()" class="btn btn-success"><span class="oi oi-print"></span></button>
<p></p>

<body>
    @if (PizarraData.reudiatablas.Count() > 0 && dataIsLoaded == 2)
    {


        <BSTable IsStriped="true" IsBordered="true">
            <BSTHead Class="cabecera">
                <BSTR>

                    @*<BSTD>Id</BSTD>*@
                    @*Centro para validar el comedor*@

                    <BSTD>@ValidationMessages.Area</BSTD>
                    <BSTD>Ksf</BSTD>
                    <BSTD>@ValidationMessages.CodigoDeEquipo</BSTD>
                    <BSTD ColSpan="4">@ValidationMessages.Discrepancia</BSTD>
                    <BSTD>@ValidationMessages.Codigo</BSTD>
                    <BSTD>@ValidationMessages.PlanDeAccion</BSTD>
                    <BSTD>@ValidationMessages.Tiempo</BSTD>
                    <BSTD>@ValidationMessages.Responsable</BSTD>
                    <BSTD>Status</BSTD>
                    <BSTD>@ValidationMessages.Requisicion</BSTD>
                    <BSTD>ODT</BSTD>
                    <BSTD>@ValidationMessages.FechaDeReunion</BSTD> @*Fecha del dia de reunion*@
                    <BSTD>@ValidationMessages.FechaDelTrabajo</BSTD>@*Fecha de listo el trabajo*@


                </BSTR>
            </BSTHead>
            <BSTBody>
                @* @if (UsrRol == "Calidad" | UsrRol == "Seguridad" | UsrRol.Substring(0,4).ToString()=="Mtto")
            @if (UsrRol == "Calidad" | UsrRol == "Seguridad" | UsrRol=="Mtto")*@
                @if (UsrRol != "")
                {
                    listareu = PizarraData.reudiatablas.Where(r => r.Responsable.StartsWith(UsrRol)).ToList();
                }
                else
                {
                    listareu = PizarraData.reudiatablas;

                }
                @* @foreach (var d in DbReunionService.reudiatablas)*@
                @foreach (var d in listareu)
                {
                    @if (linea == "Todo" | linea == d.Rdarea)
                    {
                        @if (Codigo == d.RdcodDis | Codigo == "Todo")
                        {
                            @if (Status == d.Rdstatus | Status == "Todo" | Status == "Total Pendiente" & (d.Rdstatus == "Pendiente" |
                           d.Rdstatus == "Pendiente/Responsable"))
                            {
                                @if (idrespo == 0 | idrespo == d.IdResReu)
                                {
                                    <BSTR>
                                        @*<BSTD>@d.IdReuDia</BSTD>*@

                                        <BSTD>@d.Rdarea</BSTD>
                                        <BSTD>@ValidationMessages.TraducirKsf(idPais, d.Idksf, KsfData.ksfs)</BSTD>
                                        <BSTD>@d.RdcodEq</BSTD>
                                        <BSTD ColSpan="4">@d.Rddisc.ToUpperInvariant()</BSTD>
                                        <BSTD>@d.RdcodDis</BSTD>
                                        <BSTD Class="textotabla">@d.RdplanAcc</BSTD>
                                        <BSTD>@d.Rdtiempo</BSTD>
                                        @{
                                            var nombreResponsable = RespoReuData.resporeus.FirstOrDefault(x => x.IdResReu == d.IdResReu)?.Rrnombre;
                                            var textoTraducido = ValidationMessages.ResourceManager.GetString(
                                            ValidationMessages.MapResponsableKey(nombreResponsable),
                                            CultureInfo.CurrentUICulture
                                            );
                                        }
                                        <BSTD class="@(nombreResponsable == "Por Definir" ? "Definir" : "")">@textoTraducido</BSTD>
                                        @{
                                            var estadoTraducido = d.Rdstatus switch
                                            {
                                                "Listo" => idPais == 5 ? "Ready" : "Listo",
                                                "Cerrado" => idPais == 5 ? "Closed" : "Cerrado",
                                                _ => idPais == 5 ? "Pending" : "Pendiente"
                                            };

                                            var claseEstado = d.Rdstatus switch
                                            {
                                                "Listo" => "listo",
                                                "Cerrado" => "Cerrado",
                                                _ => "pendiente"
                                                };

                                            var codRequiTexto = d.RdcodRequi == null ? "N/A" : d.RdcodRequi;
                                        }
                                        <BSTD Class="@claseEstado">@estadoTraducido</BSTD>
                                        <BSTD>@codRequiTexto</BSTD>
                                        <BSTD>@d.Rdodt</BSTD>
                                        <BSTD>@d.RdfecReu.ToString("dd/MM/yyyy")</BSTD>
                                        <BSTD>@d.RdfecTra.ToString("dd/MM/yyyy")</BSTD>

                                    </BSTR>

                                }
                            }
                        }
                    }



                }


            </BSTBody>

        </BSTable>
    }
</body>

@code {
    [Parameter]
    public string? accion { get; set; }//centro
    [Parameter]
    public string? division { get; set; }//division
    [Parameter]
    public string? f1 { get; set; }
    [Parameter]
    public string? linea { get; set; }
    [Parameter]
    public string? f2 { get; set; }
    [Parameter]
    public string? tipo { get; set; }
    [Parameter]
    public string? est { get; set; }
    [Parameter]
    public int? idrespo { get; set; }//responsable a filtar

    int dataIsLoaded = 0;
    int CentroComedor = 0;

    private string Codigo { get; set; } = "Todo"; //Codigo
    private string Status { get; set; } = "Total Pendiente"; //Status
    private string UsrAdmin { get; set; } = ""; //permisos de admin
    private string UsrRol { get; set; } = ""; //rol para filtrar
    private int idPais { get; set; }

    private List<AsistenReuDTO> listaAsistencia { get; set; }
    private List<LineaDTO> lineas { get; set; }
    private List<DivisionDTO> divisions { get; set; }
    private List<MaestraVDTO> centro { get; set; }
    private List<KsfDTO> ksfs { get; set; }
    private List<RespoReuDTO> resporeu { get; set; }
    private List<ReunionDTO> reunionditabla { get; set; }
    private List<ReunionDTO> reudiatabla { get; set; }
    private List<AsistenReuDTO> asistenreus { get; set; }
    private List<CargoReuDTO> cargoreus { get; set; }
    private List<StatsAsisDto> StatsAsisDtos { get; set; }
    private List<EquiposEamVDTO> equipos { get; set; }
    private List<EquiposEamVDTO> equiposlinea { get; set; }
    private List<EquipoEamDTO> listaEqupis { get; set; }
    private RegistroCambiosDTO listaRegistro { get; set; }
    private List<CalendarioTrabajoDTO> calentrabajo { get; set; }
    private List<CambFecDTO> cambiofecha { get; set; }
    private List<ReunionDTO> reudiatablas { get; set; }




    List<ReunionDTO> listareu = new List<ReunionDTO>();//filtar los responsables

    private List<Claim> claims { get; set; }

    private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
            var culture = new System.Globalization.CultureInfo(paisTemp == 5 ? "en" : "es");
            System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
            await LocalStorage.SetItemAsync("userCulture", culture.Name);
        }

        await RespoReuData.GetResReu();
        RespoReuData.resporeus = RespoReuData.resporeus
            .Where(a => a.Rrdesc == claims.FirstOrDefault(c => c.Type.Contains("Empresa"))?.Value 
                || string.IsNullOrEmpty(a.Rrdesc))
            .ToList();
    }

    string TraducirFiltro(string valor)
    {
        if (idPais != 5) return valor;

        return valor switch
        {
            "Todo" => "All",
            "Total Pendiente" => "Total Pending",
            "Pendiente" => "Pending",
            "Pendiente/Responsable" => "Pending/Responsible",
            "Listo" => "Ready",
            "Cerrado" => "Closed",
            "Vencidos" => "Overdue",
            _ => valor
        };
    }



    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RespoReuData.GetResReu();
        await KsfData.Getksf();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CreateData();

        switch (claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value)
        {
            case "Admin":
            case "SuperAdmin":
                UsrAdmin = "SuperAdmin";
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            case "SemiAdmin":
                UsrAdmin = "SemiAdmin";
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            case "Planificador":
            case "SuperUser":
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            case "MttoAdmin":
                UsrRol = "Mtto";
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;
            case "SeguridadAdmin":
                UsrRol = "Seguridad";//Seguridad para filtar por seguridad
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;
            case "CalidadAdmin":
                UsrRol = "Calidad";//Seguridad para filtar por calidad
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            case "Mantenimiento":
                UsrRol = "Mtto";
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            case "Auditores":
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            default:
                UsrRol = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value;
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;
        }



        if (accion != null)
        {
            string[] fec1 = f1.Split('-');
            string[] fec2 = f2.Split('-');

            //año, mes dia
            DateTime date1 = new DateTime(int.Parse(fec1[2]), int.Parse(fec1[1]), int.Parse(fec1[0]));
            DateTime date2 = new DateTime(int.Parse(fec2[2]), int.Parse(fec2[1]), int.Parse(fec2[0]));

            dataIsLoaded = 1;
            await PizarraData.GetPendientes(accion, division, date1, date2, tipo, est);
            dataIsLoaded = 2;
            foreach (var e in PizarraData.reudiatablas)
            {
                e.Ksf = KsfData.ksfs.Where(x => x.Idksf == e.Idksf).FirstOrDefault().KsfNombre;
                e.Responsable = RespoReuData.resporeus.Where(x => x.IdResReu == e.IdResReu).FirstOrDefault().Rrnombre;

            }

        }

    }
}
