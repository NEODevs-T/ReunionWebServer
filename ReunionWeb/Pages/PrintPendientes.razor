@layout EmptyLayout
@page "/es/TablaPendientes"
@page "/es/TablaPendientes/{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}/{idrespo:int}"
@page "/en/TablePending"
@page "/en/TablePending/{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}/{idrespo:int}"

@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject IMaestraData MaestraData
@inject IDiccionarioTraduccionesService DiccionarioTraduccionesService
@inject LocalizationService LocalizationService
@inject ITranslationService Translator

@using ReunionWeb.Resources
@using System.Globalization
@using ReunionWeb.Services

@if (!traduccionesCargadas || dataIsLoaded == 1)
{
    <div class="loading-container">
        <div class="loader"></div>
    </div>
}
else
{
<BSRow>
    <BSCol ColumnSmall="1" Column="2">
        <BSLabel>@DiccionarioTraduccionesService.Traducciones["Codigo"]</BSLabel>
        <BSInput InputType="InputType.Select" @bind-Value="Codigo">
            <option value="Todo">@DiccionarioTraduccionesService.Traducciones["Todo"]</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
        </BSInput>
    </BSCol>

    <BSCol ColumnSmall="1" Column="2">
        <BSLabel>@DiccionarioTraduccionesService.Traducciones["Estado"]</BSLabel>
        <BSInput InputType="InputType.Select" @bind-Value="Status">
            <option value="Total Pendiente">@DiccionarioTraduccionesService.Traducciones["TotalPendiente"]</option>
            <option value="Todo">@DiccionarioTraduccionesService.Traducciones["Todo"]</option>
            <option value="Pendiente">@DiccionarioTraduccionesService.Traducciones["Pendiente"]</option>
            <option value="Pendiente/Responsable">@DiccionarioTraduccionesService.Traducciones["Pendiente"]/ @DiccionarioTraduccionesService.Traducciones["Responsable"]</option>
            <option value="No Conforme">@DiccionarioTraduccionesService.Traducciones["NoConforme"]</option>
            <option value="Listo">@DiccionarioTraduccionesService.Traducciones["Listo"]</option>
            <option value="Cerrado">@DiccionarioTraduccionesService.Traducciones["Cerrado"]</option>
            <option value="Vencidos">@DiccionarioTraduccionesService.Traducciones["Vencidos"]</option>
        </BSInput>
    </BSCol>

    <BSCol Column="3">
        <BSLabel>@DiccionarioTraduccionesService.Traducciones["Responsable"]</BSLabel>
        <BSInput InputType="InputType.Select" @bind-Value="idrespo">
            <option value=0>@DiccionarioTraduccionesService.Traducciones["Todo"]</option>
            @foreach (var d in RespoReuData.resporeus)
            {
                var texto = idPais == 5? d.Rrenglish : d.Rrnombre;
                <option value="@d.IdResReu">@texto</option>
            }
        </BSInput>
    </BSCol>
    @{
        var lineaTraducida = idPais == 5 ? "All" : "Todos";
    }
    <BSCol Column="3">
        <BSLabel>@DiccionarioTraduccionesService.Traducciones["Linea"]</BSLabel>
        <BSInput InputType="InputType.Text" @bind-Value="@lineaTraducida" IsReadonly="true" />
    </BSCol>

</BSRow>
<button type="button" onclick="window.print()" class="btn btn-success"><span class="oi oi-print"></span></button>
<p></p>

<body>
    @if (PizarraData?.reudiatablas?.Count > 0 && dataIsLoaded == 2)
    {
        <BSTable IsStriped="true" IsBordered="true">
            <BSTHead Class="cabecera">
                <BSTR>
                    @*<BSTD>Id</BSTD>*@
                    @*Centro para validar el comedor*@

                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Area"]</BSTD>
                    <BSTD>Ksf</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]</BSTD>
                    <BSTD ColSpan="4">@DiccionarioTraduccionesService.Traducciones["Discrepancia"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Codigo"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["PlanDeAccion"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Tiempo"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Responsable"]</BSTD>
                    <BSTD>Status</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Requisicion"]</BSTD>
                    <BSTD>ODT</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDeReunion"]</BSTD> @*Fecha del dia de reunion*@
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDeTrabajo"]</BSTD>@*Fecha de listo el trabajo*@
                </BSTR>
            </BSTHead>

            <BSTBody>
                @* ✅ NO reasignar listareu aquí; ya viene filtrado en memoria *@

                @foreach (var d in listareu)
                {
                    @if (linea == "Todo" || linea == d.Rdarea)
                    {
                        @if (Codigo == d.RdcodDis || Codigo == "Todo")
                        {
                            @if (idrespo == 0 || idrespo == d.IdResReu)
                            {
                                <BSTR>
                                    @*<BSTD>@d.IdReuDia</BSTD>*@

                                    <BSTD>@d.Rdarea</BSTD>

                                    <BSTD>
                                        @{
                                            var texto = idPais == 5 
                                                ? KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfEnglish 
                                                : KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfNombre;
                                        }
                                        @texto
                                    </BSTD>

                                    <BSTD>@d.RdcodEq</BSTD>
                                    <BSTD ColSpan="4">@d.Rddisc.ToUpperInvariant()</BSTD>
                                    <BSTD>@d.RdcodDis</BSTD>
                                    <BSTD Class="textotabla">@d.RdplanAcc</BSTD>
                                    <BSTD>@d.Rdtiempo</BSTD>

                                    @{
                                        var responsable = RespoReuData.resporeus.FirstOrDefault(x => x.IdResReu == d.IdResReu);
                                        var nombreResponsable = idPais == 5 
                                            ? responsable?.Rrenglish 
                                            : responsable?.Rrnombre ?? string.Empty;
                                    }
                                    <BSTD class="@(nombreResponsable == "Por Definir" ? "Definir" : "")">@nombreResponsable</BSTD>

                                    @{
                                        // Estado visual efectivo + traducción + clase CSS
                                        var estadoEf = EstadoEfectivo(d);

                                        var claveTrad = ValidationMessages.MapStatusKey(estadoEf);
                                        var estadoTraducido = DiccionarioTraduccionesService.Traducciones.ContainsKey(claveTrad)
                                                            ? DiccionarioTraduccionesService.Traducciones[claveTrad]
                                                            : estadoEf;

                                        var claseEstado = estadoEf == "Vencidos" ? "Vencido" : d.Rdstatus switch
                                        {
                                            "Listo"   => "listo",
                                            "Cerrado" => "Cerrado",
                                            _         => "pendiente"
                                        };
                                    }

                                    <BSTD class="@claseEstado">@estadoTraducido</BSTD>

                                    @{
                                        var codRequiTexto = d.RdcodRequi == null ? "N/A" : d.RdcodRequi;
                                    }
                                    <BSTD>@codRequiTexto</BSTD>

                                    <BSTD>@d.Rdodt</BSTD>
                                    <BSTD>@d.RdfecReu.ToString("dd/MM/yyyy")</BSTD>
                                    <BSTD>@d.RdfecTra.ToString("dd/MM/yyyy")</BSTD>

                                </BSTR>
                            }
                        }
                    }
                }
            </BSTBody>
        </BSTable>
    }
</body>
}
@code {
    [Parameter] public string? accion { get; set; }//centro
    [Parameter] public string? division { get; set; }//division
    [Parameter] public string? f1 { get; set; }
    [Parameter] public string? linea { get; set; }
    [Parameter] public string? f2 { get; set; }
    [Parameter] public string? tipo { get; set; }
    [Parameter] public string? est { get; set; }
    [Parameter] public int? idrespo 
    { 
        get => _idrespo; 
        set { _idrespo = value; ReaplicarFiltrosSiListo(); } 
    }//responsable a filtar

    int dataIsLoaded = 0;
    int CentroComedor = 0;

    private string _codigo = "Todo";
    private string Codigo 
    { 
        get => _codigo; 
        set { _codigo = value; ReaplicarFiltrosSiListo(); } 
    } //Codigo

    private string _status = "Total Pendiente";
    private string Status 
    { 
        get => _status; 
        set { _status = value; ReaplicarFiltrosSiListo(); } 
    } //Status

    private string UsrAdmin { get; set; } = ""; //permisos de admin
    private string UsrRol { get; set; } = ""; //rol para filtrar
    private int idPais { get; set; }

    private int? _idrespo;

    private List<AsistenReuDTO> listaAsistencia { get; set; }
    private List<LineaDTO> lineas { get; set; }
    private List<DivisionDTO> divisions { get; set; }
    private List<MaestraVDTO> centro { get; set; }
    private List<KsfDTO> ksfs { get; set; }
    private List<RespoReuDTO> resporeu { get; set; }
    private List<ReunionDTO> reunionditabla { get; set; }
    private List<ReunionDTO> reudiatabla { get; set; }
    private List<AsistenReuDTO> asistenreus { get; set; }
    private List<CargoReuDTO> cargoreus { get; set; }
    private List<StatsAsisDto> StatsAsisDtos { get; set; }
    private List<EquiposEamVDTO> equipos { get; set; }
    private List<EquiposEamVDTO> equiposlinea { get; set; }
    private List<EquipoEamDTO> listaEqupis { get; set; }
    private RegistroCambiosDTO listaRegistro { get; set; }
    private List<CalendarioTrabajoDTO> calentrabajo { get; set; }
    private List<CambFecDTO> cambiofecha { get; set; }
    private List<ReunionDTO> reudiatablas { get; set; }
    private List<ReunionDTO> _sourceAll = new();

    List<ReunionDTO> listareu = new List<ReunionDTO>();//filtar los responsables

    private List<Claim> claims { get; set; }
    private bool traduccionesCargadas = false;

    private bool DatosListos => dataIsLoaded == 2 && PizarraData?.reudiatablas != null;

    private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }

        await RespoReuData.GetResReu();
        RespoReuData.resporeus = RespoReuData.resporeus
            .Where(a => a.Rrdesc == claims.FirstOrDefault(c => c.Type.Contains("Empresa"))?.Value 
                || string.IsNullOrEmpty(a.Rrdesc))
            .ToList();
    }

    bool EsVencido(DateTime fechaTrabajo, string? estadoOriginal)
    {
        var estado = estadoOriginal ?? string.Empty;
        return fechaTrabajo.Date < DateTime.Now.Date
            && estado.StartsWith("Pendiente", StringComparison.OrdinalIgnoreCase);
    }

    private string EstadoEfectivo(ReunionDTO d)
    {
        var original = d.Rdstatus ?? string.Empty;
        return EsVencido(d.RdfecTra, original) ? "Vencidos" : original;
    }

    private bool EsOpcionTotalPendiente(string? s)
    {
        var valor = (s ?? string.Empty).Trim();
        var tieneDic = DiccionarioTraduccionesService.Traducciones != null &&
                    DiccionarioTraduccionesService.Traducciones.ContainsKey("TotalPendiente");
        var traducidoTP = tieneDic ? DiccionarioTraduccionesService.Traducciones["TotalPendiente"] : "Total Pendiente";
        return valor.Equals("Total Pendiente", StringComparison.OrdinalIgnoreCase)
            || valor.Equals("Total Pending", StringComparison.OrdinalIgnoreCase)
            || valor.Equals(traducidoTP, StringComparison.OrdinalIgnoreCase);
    }

    private bool EsOpcionVencidos(string? s)
    {
        var valor = (s ?? string.Empty).Trim();
        var traducidoVencidos = DiccionarioTraduccionesService.Traducciones.ContainsKey("Vencidos")
            ? DiccionarioTraduccionesService.Traducciones["Vencidos"]
            : "Vencidos";
        return valor.Equals("Vencidos", StringComparison.OrdinalIgnoreCase)
            || valor.Equals("Expired", StringComparison.OrdinalIgnoreCase)
            || valor.Equals(traducidoVencidos, StringComparison.OrdinalIgnoreCase);
    }

    private bool EsOpcionTodo(string? s)
    {
        var valor = (s ?? string.Empty).Trim();
        var traducidoTodo = DiccionarioTraduccionesService.Traducciones.ContainsKey("Todo")
            ? DiccionarioTraduccionesService.Traducciones["Todo"]
            : "Todo";
        return valor.Equals("Todo", StringComparison.OrdinalIgnoreCase)
            || valor.Equals(traducidoTodo, StringComparison.OrdinalIgnoreCase);
    }

    string TraducirFiltro(string valor)
    {
        if (idPais != 5) return valor;

        return valor switch
        {
            "Todo" => "All",
            "Total Pendiente" => "Total Pending",
            "Pendiente" => "Pending",
            "Pendiente/Responsable" => "Pending/Responsible",
            "Listo" => "Ready",
            "Cerrado" => "Closed",
            "Vencidos" => "Overdue",
            _ => valor
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RespoReuData.GetResReu();
        await KsfData.Getksf();
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        await CreateData();

        switch (claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value)
        {
            case "Admin":
            case "SuperAdmin":
                UsrAdmin = "SuperAdmin";
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            case "SemiAdmin":
                UsrAdmin = "SemiAdmin";
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            case "Planificador":
            case "SuperUser":
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            case "MttoAdmin":
                UsrRol = "Mtto";
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            case "SeguridadAdmin":
                UsrRol = "Seguridad";
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            case "CalidadAdmin":
                UsrRol = "Calidad";
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            case "Mantenimiento":
                UsrRol = "Mtto";
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;

            case "Auditores":
                await MaestraData.GetCentrosxEmpresa("All" + claims.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value);
                break;

            default:
                UsrRol = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value;
                await MaestraData.GetCentrosxEmpresa(claims.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value);
                break;
        }

        if (!string.IsNullOrWhiteSpace(accion))
        {
            try
            {
                // Fechas (robusto): dd-MM-yyyy
                if (!DateTime.TryParseExact(f1 ?? string.Empty, "dd-MM-yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date1))
                    date1 = DateTime.Now;
                if (!DateTime.TryParseExact(f2 ?? string.Empty, "dd-MM-yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date2))
                    date2 = DateTime.Now;

                Status = est is null ? Status : Uri.UnescapeDataString(est);
                linea  = string.IsNullOrWhiteSpace(linea) ? "Todo" : Uri.UnescapeDataString(linea);

                dataIsLoaded = 1;

                var estConsulta = "Todo";

                await PizarraData.GetPendientes(accion, division, date1, date2, tipo, estConsulta);

                dataIsLoaded = 2;

                if (PizarraData?.reudiatablas is null)
                {
                    listareu = new();
                    return;
                }

                foreach (var e in PizarraData.reudiatablas)
                {
                    e.Ksf = KsfData.ksfs.Where(x => x.Idksf == e.Idksf).FirstOrDefault()?.KsfNombre;
                    e.Responsable = RespoReuData.resporeus.Where(x => x.IdResReu == e.IdResReu).FirstOrDefault()?.Rrnombre ?? string.Empty;
                }

                _sourceAll = PizarraData.reudiatablas.ToList();

                ConstruirListaBase();
                AplicarFiltrosEnMemoria();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[TablaPendientes] Error en OnParametersSetAsync: {ex}");
                listareu = new();
                dataIsLoaded = 2; // Evita estado de "cargando" infinito
            }
        }
    }

    private void ReaplicarFiltrosSiListo()
    {
        if (!DatosListos) return; // no ejecutar mientras carga
        ConstruirListaBase();
        AplicarFiltrosEnMemoria();
        InvokeAsync(StateHasChanged);
    }

    private void ConstruirListaBase()
    {
        if (_sourceAll is null)
        {
            listareu = new();
            return;
        }

        if (!string.IsNullOrEmpty(UsrRol))
            listareu = _sourceAll
                .Where(r => !string.IsNullOrEmpty(r.Responsable) && r.Responsable.StartsWith(UsrRol))
                .ToList();
        else
            listareu = _sourceAll.ToList();
    }

    private void AplicarFiltrosEnMemoria()
    {
        if (listareu is null) listareu = new();

        if (EsOpcionVencidos(Status))
        {
            listareu = listareu
                .Where(d => EsVencido(d.RdfecTra, d.Rdstatus ?? string.Empty))
                .ToList();
        }
        else if (EsOpcionTotalPendiente(Status))
        {
            listareu = listareu
                .Where(d => (d.Rdstatus ?? string.Empty)
                    .StartsWith("Pendiente", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        else if (EsOpcionTodo(Status))
        {
            // "Todo": no aplicar filtro por estado aquí
        }
        else
        {
            var s = (Status ?? string.Empty).Trim();

            if (s.Equals("Pendiente", StringComparison.OrdinalIgnoreCase))
            {
                listareu = listareu
                    .Where(d => string.Equals(d.Rdstatus ?? string.Empty,
                                            "Pendiente",
                                            StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            else if (s.Equals("Pendiente/Responsable", StringComparison.OrdinalIgnoreCase))
            {
                listareu = listareu
                    .Where(d => string.Equals(d.Rdstatus ?? string.Empty,
                                            "Pendiente/Responsable",
                                            StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            else if (s.Equals("No Conforme", StringComparison.OrdinalIgnoreCase))
            {
                listareu = listareu
                    .Where(d => string.Equals(d.Rdstatus ?? string.Empty,
                                            "No Conforme",
                                            StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
            else
            {
                listareu = listareu
                    .Where(d => string.Equals(d.Rdstatus ?? string.Empty, s, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }
        }

        var permitirVencidos =
            EsOpcionVencidos(Status) || EsOpcionTotalPendiente(Status) || EsOpcionTodo(Status);

        if (!permitirVencidos)
        {
            listareu = listareu
                .Where(d => EstadoEfectivo(d) != "Vencidos")
                .ToList();
        }

        if (!string.Equals(Codigo, "Todo", StringComparison.OrdinalIgnoreCase))
        {
            listareu = listareu
                .Where(d => string.Equals(d.RdcodDis, Codigo, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        if (_idrespo.HasValue && _idrespo.Value > 0)
        {
            listareu = listareu
                .Where(d => d.IdResReu == _idrespo.Value)
                .ToList();
        }
    }
}