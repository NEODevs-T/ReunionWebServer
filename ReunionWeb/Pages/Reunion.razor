</BSContainer>

<p>
</p>


@if (registrosVisibles.Count > 0 && dataIsLoaded == 2)
{
    <BSContainer>
        <BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
            <BSTHead Class="cabecera">
                <BSTR>
                    @*<BSTD>Id</BSTD>*@
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Area"]</BSTD>
                    <BSTD>Ksf</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["NombreDelEquipo"]</BSTD>
                    <BSTD ColSpan="4">@DiccionarioTraduccionesService.Traducciones["Discrepancia"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Codigo"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["PlanDeAccion"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Tiempo"]</BSTD>
                    <BSTD ColSpan="1">@DiccionarioTraduccionesService.Traducciones["Responsable"]</BSTD>
                    <BSTD>Status</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Requisicion"]</BSTD>
                    <BSTD>ODT</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDeTrabajo"]</BSTD>
                    @if (Rol == "Admin" || Rol == "AdminChempro" || Rol == "PrimeUser" || Rol == "SuperUser" || Rol == "SemiAdmin")
                    {
                        <BSTD></BSTD>
                    }
                </BSTR>
            </BSTHead>
            <BSTBody>
                @foreach (var d in registrosVisibles)
                {
                    @if (Codigo == d.RdcodDis || Codigo == "Todo")
                    {
                        <BSTR class="@GetRowClass(d)">
                            @*<BSTD>@d.IdReuDia</BSTD>*@
                            @* <BSTD>@d.Rddiv</BSTD>*@
                            <BSTD>@d.Rdarea</BSTD>
                            @{
                                var textoKsf = idPais == 5 
                                    ? KsfData.ksfs.FirstOrDefault(x => x.Idksf == d.Idksf)?.KsfEnglish 
                                    : KsfData.ksfs.FirstOrDefault(x => x.Idksf == d.Idksf)?.KsfNombre;
                            }
                            @textoKsf
                            <BSTD>@d.RdcodEq</BSTD>
                            <BSTD>
                                @{
                                    var textoEquipo = string.IsNullOrWhiteSpace(d.EnombreEam)
                                        ? (idPais == 5 ? "EQUIPMENT NOT FOUND" : "EQUIPO NO ENCONTRADO")
                                        : d.EnombreEam;
                                }
                                @textoEquipo
                            </BSTD>
                            <BSTD ColSpan="4">@d.Rddisc.ToUpper()</BSTD>
                            <BSTD>@d.RdcodDis</BSTD>
                            <BSTD Class="textotabla">@d.RdplanAcc</BSTD>
                            <BSTD>@d.Rdtiempo</BSTD>
                            @{
                                var responsable = RespoReuData.resporeus.FirstOrDefault(x => x.IdResReu == d.IdResReu);
                                var nombreResponsable = idPais == 5 
                                    ? responsable?.Rrenglish 
                                    : responsable?.Rrnombre ?? string.Empty;
                                    }
                            <BSTD class="@(nombreResponsable == "Por Definir" ? "Definir" : "")">@nombreResponsable</BSTD>
                            @{
                                var estadoTraducido = d.Rdstatus switch
                                {
                                    "Listo" => idPais == 5 ? "Ready" : "Listo",
                                    "Cerrado" => idPais == 5 ? "Closed" : "Cerrado",
                                    "Revisar" => idPais == 5 ? "Review" : "Revisar",
                                    _ => idPais == 5 ? "Pending" : "Pendiente"
                                };

                                var claseEstado = d.Rdstatus switch
                                {
                                    "Listo" => "listo",
                                    "Cerrado" => "Cerrado",
                                    "Revisar" => "Revisar",
                                    _ => "pendiente"
                                };

                                var codRequiTexto = d.RdcodRequi ?? "N/A";
                            }
                            <BSTD Class="@claseEstado">@estadoTraducido</BSTD>
                            <BSTD>@codRequiTexto</BSTD>
                            <BSTD>@d.Rdodt</BSTD>
                            <BSTD>@d.RdfecTra.ToString("dd/MM/yyyy")</BSTD>
                            @if (Rol == "Admin" || Rol == "AdminChempro" || Rol == "PrimeUser" || Rol == "SuperUser" || Rol == "SemiAdmin")
                            {
                                <BSTD>
                                    <button class="btn btn-success" @onclick="(() => Editar(d.IdReuDia))">
                                        <i class="oi oi-pencil"></i>
                                    </button>
                                </BSTD>
                            }
                        </BSTR>
                    }
                }
            </BSTBody>
        </BSTable>
    </BSContainer>
}
else if (dataIsLoaded == 1 && registrosVisibles.Count == 0)
{
    <div class="loader"></div>
}
else if (dataIsLoaded == 2 && registrosVisibles.Count == 0)
{
    <div style="text-align: center; padding: 20px; font-size: 18px; color: rgb(102, 101, 101);">
        <p>@DiccionarioTraduccionesService.Traducciones["NoHayDatos2"]</p>
    </div>
}
}

@code {

    [Parameter]
    public string? accion { get; set; }//centro
    [Parameter]
    public string? division { get; set; }//division
    [Parameter]
    public string? linea { get; set; }//linea
    [Parameter]
    public string? f1 { get; set; }
    [Parameter]
    public string? f2 { get; set; }
    [Parameter]
    public string? tipo { get; set; }
    [Parameter]
    public string? est { get; set; }
     [Parameter]
    public string? codigo { get; set; }
    [Parameter]
    public int? responsable { get; set; }
    [Parameter]
    public int? KsfF { get; set; }


    int dataIsLoaded = 0, filtrocod = 0;
    string ayer = DateTime.Now.AddDays(-1).ToString("yyyyMMdd");
    string error;

    private int IdCentro { get; set; } = 0; //id del Centro
    private int IdDiv { get; set; } = 0; //id de la division
    private int CentroComedor;//Variable para verificar si es el comedor venezuela;
        private NotifiRadzen Notificar = new NotifiRadzen();//Logic para crear las noyificaciones radzen


    //private string Div { get; set; } //Centro
    //private string Division { get; set; } //División


    private string Codigo { get; set; } = "Todo"; //Codigo
    private string Rol { get; set; } = ""; //Rol del usuario

    private string mensaje {get; set; } = "";

    private List<Claim> claims { get; set; }
    private int idPais {get; set;}
    private bool traduccionesCargadas = false;

List<ReunionDTO> registrosVisibles
{
    get
    {
        DateTime fechaInicio;
        DateTime fechaFin;

        // Lógica de lunes igual que en la API
        if (DateTime.Today.DayOfWeek == DayOfWeek.Monday)
        {
            fechaInicio = DateTime.Now.AddDays(-3);
            fechaFin = DateTime.Now.AddDays(+1);
        }
        else
        {
            fechaInicio = DateTime.Now.AddDays(-1);
            fechaFin = DateTime.Now.AddDays(+1);
        }

        return PizarraData.reudiatablas
            .Where(d => d.Rdstatus != "Rechazada"
                     && d.Rdstatus != "Listo"
                     && d.Rdstatus != "Cerrado"
                     &&
                     (
                         (d.RdfecReu.Date >= fechaInicio.Date && d.RdfecReu.Date <= fechaFin.Date)
                     )
            )
            .OrderBy(d => TienePlanYResponsable(d)) // FALSE primero, TRUE al final
            .ToList();

    }
}


    private async Task CreateData()

    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }
    }

    
private async Task SetCentroInicialAsync()
    {
        // Confirmar que hay centros cargados
        if (MaestraData?.centro == null || !MaestraData.centro.Any())
            return;

        // Tomar IdCentro del claim (evita usar índices frágiles como claims[11])
        var idCentroClaimStr = claims?.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value;
        int.TryParse(idCentroClaimStr, out var idCentroClaim);

        // Usa el claim si coincide; si no, el primero de la lista
        if (idCentroClaim > 0 && MaestraData.centro.Any(x => x.IdCentro == idCentroClaim))
        {
            IdCentro = idCentroClaim;
        }
        else
        {
            IdCentro = MaestraData.centro.First().IdCentro;
        }

        // Disparar lógica dependiente manualmente
        await BuscarDivision(new ChangeEventArgs { Value = IdCentro });

        StateHasChanged();
    }



protected override async Task OnInitializedAsync()
{
    await CreateData();
    await LocalizationService.EstablecerCulturaDesdeTokenAsync();
    CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture;
    CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture;
    await DiccionarioTraduccionesService.CargarTraduccionesAsync();
    traduccionesCargadas = true;

    Rol = claims?.FirstOrDefault(c => c.Type.Contains("role"))?.Value;
    var idEmpresa = claims?.FirstOrDefault(c => c.Type.Contains("IdEmpresa"))?.Value;
    var idCentroClaim = claims?.FirstOrDefault(c => c.Type.Contains("IdCentro"))?.Value;

    // Roles que ven "All + Empresa"
    bool rolMantienePlaceholder = Rol is "Admin" or "SuperAdmin" or "PrimeUser" or "MttoAdmin" or "SeguridadAdmin" or "CalidadAdmin" or "Auditores";

    if (rolMantienePlaceholder && !string.IsNullOrWhiteSpace(idEmpresa))
    {
        await MaestraData.GetCentrosxEmpresa("All" + idEmpresa);
    }
    else
    {
        await MaestraData.GetCentrosxEmpresa(idCentroClaim);
    }

    await KsfData.Getksf();
    await RespoReuData.GetResReu();

    // --- AQUÍ va la decisión y el llamado ---
    if (rolMantienePlaceholder)
    {
        // Estos roles: mostrar "Seleccione", no auto-seleccionar
        IdCentro = 0;
        // No llamamos BuscarDivision aún (no hay centro escogido)
    }
    else
    {
        // Otros roles: auto-selección
        await SetCentroInicialAsync();
    }
}

    protected async Task BuscarDivision(ChangeEventArgs e)
    {
            IdCentro = int.Parse(e.Value.ToString());
            IdDiv = 0;
            try{
                if(IdCentro != 0){
                    MaestraData.divisions = await MaestraData.ObtenerDivisionDelCentro(IdCentro);
                }
            }catch(Exception ex){
                mensaje = "Error: " + ex.Message;
            }
    }


    protected async Task Get()
    {
        if (IdCentro != 0 & IdDiv != 0)
        {
            error = null;
            if (dataIsLoaded != 1)
            {
                dataIsLoaded = 1;
                await PizarraData.GetPendientes(IdCentro.ToString(), IdDiv.ToString(), DateTime.Now.AddDays(-1), DateTime.Now, "1",
                "Reunion");
                            PizarraData.reudiatablas = PizarraData.reudiatablas.OrderBy(d => TienePlanYResponsable(d)).ToList();
                dataIsLoaded = 2;
            }
        }
        else
        {

        NotificationService.Notify(Notificar.Notificacion("advertencia", DiccionarioTraduccionesService.Traducciones["Atencion"], DiccionarioTraduccionesService.Traducciones["SVLista"]));

        }
    }
    void Editar(int id)
    {
        var ruta = idPais == 5 ? "en" : "es";
        var fechaInicio = DateTime.Now.AddDays(-1).ToString("dd-MM-yyyy");
        var fechaFin = DateTime.Now.ToString("dd-MM-yyyy");
        var url = $"{ruta}/EditDisc/{id}/1/Re/{fechaInicio}/{fechaFin}/Reunion";
        NavigationManager.NavigateTo(url);
        //NavigationManager.NavigateTo($"EditDisc/{id}/1/Re/{DateTime.Now.AddDays(-1).ToString("dd-MM-yyyy")}/{DateTime.Now.ToString("dd-MM-yyyy")}/Reunion");
    }
    protected override async Task OnParametersSetAsync()
    {
        if (accion != null)
        {
            dataIsLoaded = 1;
            IdCentro = int.Parse(accion);
            IdDiv = int.Parse(division);
            await PizarraData.GetPendientes(accion, division, DateTime.Now.AddDays(-1), DateTime.Now, tipo, "Reunion");
                    PizarraData.reudiatablas = PizarraData.reudiatablas.OrderBy(d => TienePlanYResponsable(d)).ToList();
            dataIsLoaded = 2;
        }

    }
    private bool TienePlanYResponsable(dynamic d)
    {
        var plan = d?.RdplanAcc ?? string.Empty;

        var responsable = RespoReuData.resporeus
            .FirstOrDefault(x => x.IdResReu == d?.IdResReu);
        
        var nombreResponsable = idPais == 5 ?
        responsable?.Rrenglish : responsable?.Rrnombre;

        bool tienePlan =
        !string.IsNullOrWhiteSpace(plan);
        bool tieneResposable =
        !string.IsNullOrWhiteSpace(nombreResponsable);

            return tienePlan && tieneResposable;
    }

    private string GetRowClass(dynamic d)
    {
        return TienePlanYResponsable(d) ? "con-plan-resp" : string.Empty;
    }

    public async Task PrintDocument()
    {
        string idiomaRuta = idPais == 5 ? "en" : "es";
        string nombrePagina = idPais == 5 ? "TableMeeting" : "TablaReunion";
        string url = $"{idiomaRuta}/{nombrePagina}/{IdCentro}/{IdDiv}/{DateTime.Now.AddDays(-1):dd-MM-yyyy}/{DateTime.Now:dd-MM-yyyy}/1";
        
        await IJS.InvokeAsync<object>("open", new object[] { url, "_blank" });
    }

}