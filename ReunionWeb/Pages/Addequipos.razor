@code {
    [Required(ErrorMessage = "Seleccione el Centro.")]
    private int IdCent { get; set; }
    [Required(ErrorMessage = "Seleccione la división.")]
    private int IdDiv { get; set; } 
    [Required(ErrorMessage = "Seleccione la Línea.")]
    private int IdLin { get; set; }

    private string EquipoFiltro { get; set; } = "";
    private int tipo { get; set; } = 0;
    private int idequipoeditar { get; set; } = 0;//id para mostrar los campos de edición
    private string mensaje = "", result = "";//resultado del save

    int dataIsLoaded = 0;
    string _message;
    private NotifiRadzen Notificar = new NotifiRadzen(); //Logic para crear las notificaciones radzen
    
    EquipoEamDTO EquipoForm = new EquipoEamDTO();
    private int idPais { get; set; }

    private List<Claim> claims { get; set; }
    private bool traduccionesCargadas = false;

    private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = user.Claims.ToList();

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }
    }

protected async Task Get()
{
    try
    {
        tipo = 2;

        // Validar que la línea esté seleccionada
        if (IdLin == 0)
        {
            mensaje = DiccionarioTraduccionesService.Traducciones["CamposNecesarios"];
            NotificationService.Notify(Notificar.Notificacion("advertencia", DiccionarioTraduccionesService.Traducciones["Atencion"], mensaje));
            return;
        }

        dataIsLoaded = 1;

        // Obtener equipos por línea
        var equipos = await MaestraData.GetEquiposPorLinea(IdLin.ToString());

        if (equipos == null || !equipos.Any())
        {
            mensaje = DiccionarioTraduccionesService.Traducciones["Nequipos"];
            NotificationService.Notify(Notificar.Notificacion("advertencia", DiccionarioTraduccionesService.Traducciones["Atencion"], mensaje));
        }

        dataIsLoaded = 2;
    }
    catch (Exception ex)
    {
        mensaje = DiccionarioTraduccionesService.Traducciones["ErrorInesp"] + ex.Message;
        NotificationService.Notify(Notificar.Notificacion("error", DiccionarioTraduccionesService.Traducciones["EDato"], mensaje));
        dataIsLoaded = 0;
    }
}


    protected async Task BuscarDivision(ChangeEventArgs e)
    {
        if (!string.IsNullOrWhiteSpace(e.Value?.ToString()) && int.TryParse(e.Value.ToString(), out int selectedCentro))
        {
            IdCent = selectedCentro;
            try
            {
                if (IdCent != 0)
                {
                    MaestraData.divisions = await MaestraData.ObtenerDivisionDelCentro(IdCent);
                }
            }
            catch (Exception ex)
            {
                mensaje = "Error: " + ex.Message;
            }
        }
        else
        {
            mensaje = "El valor del centro seleccionado no es válido.";
        }
    }

    protected async Task BuscarLinea(ChangeEventArgs e)
    {
        if (!string.IsNullOrWhiteSpace(e.Value?.ToString()) && int.TryParse(e.Value.ToString(), out int selectedDivision))
        {
            IdDiv = selectedDivision;
            try
            {
                if (IdDiv != 0)
                {
                    MaestraData.lineas = await MaestraData.ObtenerLasLineasPorDivision(IdDiv);
                }
            }
            catch (Exception ex)
            {
                mensaje = "Error: " + ex.Message;
            }
        }
        else
        {
            mensaje = "El valor del centro seleccionado no es válido.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CreateData();
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;
        if (claims != null && claims.Count > 10)
        {
            await MaestraData.GetCentrosxEmpresa("All" + claims[10].Value);
        }
    }

protected async Task SaveEquipo(EditContext e)
{
    if (e.Validate())
    {
        // Validación manual adicional
        if (string.IsNullOrWhiteSpace(EquipoForm.EcodEquiEam) ||
            string.IsNullOrWhiteSpace(EquipoForm.EnombreEam) ||
            string.IsNullOrWhiteSpace(EquipoForm.EdescriEam) ||
            IdLin == 0)
        {
            mensaje = DiccionarioTraduccionesService.Traducciones["TodosCampos"];
            NotificationService.Notify(Notificar.Notificacion("advertencia", DiccionarioTraduccionesService.Traducciones["Atencion"], mensaje));
            return;
        }

        try
        {
            EquipoForm.Efecha = DateTime.Now;
            EquipoForm.IdLinea = IdLin;
            EquipoForm.EestaEam = true;
            EquipoForm.EcodEquiEam = EquipoForm.EcodEquiEam?.Replace(" ", string.Empty);
            EquipoForm.Linea = MaestraData.lineas.FirstOrDefault(l => l.IdLinea == IdLin)?.Linea ?? "Desconocida";
            EquipoForm.IdEmpresa = int.TryParse(claims.FirstOrDefault(c => c.Type.Contains("Empresa"))?.Value, out int empresaId) ? empresaId : 0;


            Console.WriteLine("=== DATOS DEL EQUIPO A ENVIAR ===");
            Console.WriteLine($"IdEquipo: {EquipoForm.IdEquipo}");
            Console.WriteLine($"IdLinea: {EquipoForm.IdLinea}");
            Console.WriteLine($"EcodEquiEam: {EquipoForm.EcodEquiEam}");
            Console.WriteLine($"EnombreEam: {EquipoForm.EnombreEam}");
            Console.WriteLine($"EdescriEam: {EquipoForm.EdescriEam}");
            Console.WriteLine($"EestaEam: {EquipoForm.EestaEam}");
            Console.WriteLine($"Efecha: {EquipoForm.Efecha}");
            Console.WriteLine($"Tipo de objeto: {EquipoForm.GetType().FullName}");


            mensaje = await MaestraData.AddEquipo(EquipoForm);

            if (mensaje == DiccionarioTraduccionesService.Traducciones["RExitoso"])
            {
                NotificationService.Notify(Notificar.Notificacion("exito", mensaje, ""));
                await Reset();
            }
            else
            {
                NotificationService.Notify(Notificar.Notificacion("advertencia", DiccionarioTraduccionesService.Traducciones["Atencion"], mensaje));
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(Notificar.Notificacion("error", DiccionarioTraduccionesService.Traducciones["EDato"], ex.Message));
        }
    }
}


    async Task Habilitar(int id)
    {
        idequipoeditar = id;
    }

    async Task Cancelar()
    {
        idequipoeditar = 0;
    }

    async Task Editar(EquipoEamDTO equipo)
    {
        try
        {
            EquipoEamDTO eq = new EquipoEamDTO
            {
                IdEquipo = equipo.IdEquipo,
                IdLinea = equipo.IdLinea,
                EcodEquiEam = equipo.EcodEquiEam,
                EdescriEam = equipo.EdescriEam,
                EestaEam = equipo.EestaEam,
                EnombreEam = equipo.EnombreEam,
                Efecha = DateTime.Now
            };
            
            mensaje = await MaestraData.UpdateEquipo(eq);

            if (mensaje == DiccionarioTraduccionesService.Traducciones["RExitoso"])
            {
                NotificationService.Notify(Notificar.Notificacion("exito", mensaje, ""));
            }
            else
            {
                NotificationService.Notify(Notificar.Notificacion("exito", DiccionarioTraduccionesService.Traducciones["AExitoso"], ""));
            }

            idequipoeditar = 0;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(Notificar.Notificacion("error", DiccionarioTraduccionesService.Traducciones["EDato"], ex.Message));
        }
    }

    protected async Task Reset()
    {
        EquipoForm = new EquipoEamDTO();
        IdCent = 0;
    }
    
    private IEnumerable<EquipoEamDTO> EquiposFiltrados =>
    string.IsNullOrWhiteSpace(EquipoFiltro) || EquipoFiltro.Length <= 2
    ? MaestraData.equiposlinea
    : MaestraData.equiposlinea.Where(a => a.EcodEquiEam.Contains(EquipoFiltro, StringComparison.OrdinalIgnoreCase));

    }
    

