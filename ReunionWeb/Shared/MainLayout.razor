@code {
    


    [CascadingParameter]
    private List<Claim> claims { get; set; }

    private string _message = "", mensaje = "";
    UserLoginDto user = new UserLoginDto();
    private bool carga = false;
    private NotifiRadzen Notificar = new NotifiRadzen();
    private int idioma  {get; set;} = 1;
    //private bool _buttonDisabled = true;
    //private BSAlert? _alertRef;
    protected override async Task OnInitializedAsync()
    {
        var cultureName = await LocalStorage.GetItemAsync<string>("userCulture") ?? "es";
        var culture = new CultureInfo(cultureName);
        CultureInfo.DefaultThreadCurrentCulture = culture;
        CultureInfo.DefaultThreadCurrentUICulture = culture;
    }

    protected async Task HandleLogin(EditContext e)
    {
        mensaje = "";
        user.Proyecto = "ReunionDiaria";
        var culture = idioma == 1 ? new CultureInfo("es") : new CultureInfo("en");
        CultureInfo.DefaultThreadCurrentCulture = culture;
        CultureInfo.DefaultThreadCurrentUICulture = culture;
        if (e.Validate())
        {
            carga = true;
            var result = await Http.PostAsJsonAsync("http://neo.paveca.com.ve/Authentication/api/Auth/Login", user);
            var ValidarToken = await result.Content.ReadAsStringAsync();
            if (ValidarToken != null)
            {
                if (ValidarToken == "NotFoundUser")
                {
                    if (idioma == 1)
                    {
                        mensaje = "Verifique el usuario.";
                        NotificationService.Notify(Notificar.Notificacion("advertencia", "Atención",mensaje));
                    }else if(idioma == 2)
                    {
                        mensaje = "Check the user.";
                        NotificationService.Notify(Notificar.Notificacion("advertencia", "Attention",mensaje));
                    }
                    carga = false;
                }
                else if (ValidarToken == "WrongPassword")
                {
                    if (idioma == 1)
                    {
                        mensaje = "Contraseña Incorrecta.";
                        NotificationService.Notify(Notificar.Notificacion("error", "Atención", mensaje));
                    }else if(idioma ==2)
                    {
                        mensaje = "Check the password";
                        NotificationService.Notify(Notificar.Notificacion("advertencia", "Attention",mensaje));
                    }
                    carga = false;
                }
                else if (ValidarToken == "null")
                {
                    if (idioma == 1)
                    {
                        mensaje = "Este usuario no está registrado en este proyecto."; 
                        NotificationService.Notify(Notificar.Notificacion("error", "Atención", mensaje));
                    }else if (idioma == 2)
                    {
                        mensaje = "This user don't register in this project";
                        NotificationService.Notify(Notificar.Notificacion("error", "Attention", mensaje));
                    }
                    carga = false;
                }
                else
                {
                    if (idioma == 1)
                    {
                        mensaje = "Accediendo...";
                    }else if (idioma == 2)
                    {
                        mensaje = "Accessing...";
                    }
                    Console.WriteLine(ValidarToken);
                    await LocalStorage.SetItemAsync("ReunionDiariaToken", ValidarToken);
                    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                    var userA = authState.User;
                    claims = Enumerable.ToList(userA.Claims);
                    user = new UserLoginDto();
                    carga = false;
                    mensaje = ""; 
                    var cultureName = idioma == 2 ? "en" : "es";
                    string homeUrl = cultureName == "en" 
                        ? $"{NavigationManager.BaseUri}en/home" 
                        : $"{NavigationManager.BaseUri}es/inicio";
                    NavigationManager.NavigateTo(homeUrl);
                }
            }
        }
    }

}